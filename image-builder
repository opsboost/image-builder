install_bootloader_efi() {
    local esp_dev
    esp_dev="${1}"
    local rootfs_dev
    rootfs_dev="${2}"
    local mnt_path
    mnt_path="${3}"
    local boot_entry_file
    boot_entry_file="${4}"
    local version
    version="${5}"

    info "Installing bootloader to ESP"
    reexec_privileged

    # Ensure bootctl is available; install it on Ubuntu if missing (e.g. if run from github action
    if ! command -v bootctl >/dev/null 2>&1; then
        local os
        os="$(sys_os)"
        if [ "ubuntu" = "${os}" ]; then
            info "bootctl not found: Installing on Ubuntu"
            install_bootctl
        fi
    fi

    mkdir -p "${mnt_path}"
    chmod 700 "${mnt_path}" || true

    # Sanity checks: device must exist
    if [ -z "${esp_dev}" ]; then
        error "install_bootloader_efi: Missing ESP device (arg #1)"
        exit 1
    fi
    if [ ! -b "${esp_dev}" ] && [ ! -c "${esp_dev}" ]; then
        error "install_bootloader_efi: ESP device does not exist: ${esp_dev}"
        lsblk -f || true
        exit 1
    fi

    # Avoid double-mount: mount only if not already mounted
    if findmnt -rno TARGET "${mnt_path}" >/dev/null 2>&1; then
        info "ESP already mounted at ${mnt_path}"
    else
        # Prefer explicit vfat mount with safe options
        if ! mount -t vfat -o codepage=437,iocharset=utf8,shortname=mixed,umask=077 "${esp_dev}" "${mnt_path}"; then
            info "Mount failed, attempting vfat fsck"
            command -v fsck.vfat >/dev/null 2>&1 && fsck.vfat -a "${esp_dev}" || true
            sleep 1
            if ! mount -t vfat -o codepage=437,iocharset=utf8,shortname=mixed,umask=077 "${esp_dev}" "${mnt_path}"; then
                error "$(printf "Failed to install bootloader to efi system partition (esp): %s at path: %s\n" "${esp_dev}" "${mnt_path}")"
                dmesg | tail -n 50 || true
                exit 1
            fi
        fi
    fi

    # Populate esp partition
    printf "\n"
    printf "Creating esp content at path %s..\n" "${mnt_path}"
    bootctl --esp-path="${mnt_path}" install
    # Fix random-seed permissions warnings from bootctl
    chmod 700 "${mnt_path}" || true
    if [ -d "${mnt_path}/loader" ]; then
        find "${mnt_path}/loader" -maxdepth 1 -type f -name "random-seed" -exec chmod 600 {} \; 2>/dev/null || true
        find "${mnt_path}/loader" -maxdepth 1 -type f -name ".#bootctlrandom-seed*" -exec chmod 600 {} \; 2>/dev/null || true
    fi

    # Create boot entry
    local boot_entry_title
    boot_entry_title="linux-${version}"

    local root_partuuid
    root_partuuid="$(blkid -o value -s PARTUUID "${rootfs_dev}")"
    if [ -z "${root_partuuid}" ]; then
        error "$(printf "install_bootloader_efi: Failed to read PARTUUID of %s\n" "${rootfs_dev}")"
        exit 1
    fi

    create_boot_entry "PARTUUID=${root_partuuid}" "${boot_entry_file}" "${boot_entry_title}"

    printf "\n"
    ls -al "${mnt_path}"
    printf "\n"
    info "$(printf "Boot entry:\n")"
    cat "${boot_entry_file}"
    printf "\n"

    unmount_recursive "${mnt_path}"
    sleep 3
}

install_kernel() {
    local kernel
    kernel="${1}"
    local esp_dev
    esp_dev="${2}"
    local mnt_path
    mnt_path="${3}"
    local fs_type
    fs_type="vfat"

    info "Installing kernel"
    reexec_privileged
    modprobe vfat || true
    mkdir -p "${mnt_path}"
    chmod 700 "${mnt_path}" || true

    info "Installing kernel\n"

    if [ -z "${esp_dev}" ]; then
        error "install_kernel: Missing device for ESP (arg #2)"
        exit 1
    fi
    if [ ! -b "${esp_dev}" ] && [ ! -c "${esp_dev}" ]; then
        error "install_kernel: Device does not exist: ${esp_dev}"
        lsblk -f || true
        exit 1
    fi

    info "Mounting disk image: ${esp_dev} with ${fs_type} at ${mnt_path}"

    # Verify filesystem type before mounting
    if command -v blkid >/dev/null 2>&1; then
        fs_probe=$(blkid -o value -s TYPE "${esp_dev}" || true)
        if [ -n "${fs_probe}" ] && [ "vfat" != "${fs_probe}" ] && [ "fat" != "${fs_probe}" ] && [ "msdos" != "${fs_probe}" ]; then
            error "install_kernel: ESP is not FAT/vfat (detected: ${fs_probe})"
        fi
    fi

    # Avoid double-mount
    if findmnt -rno TARGET "${mnt_path}" >/dev/null 2>&1; then
        info "ESP already mounted at ${mnt_path}"
    else
        if ! mount -t "${fs_type}" -o codepage=437,iocharset=utf8,shortname=mixed,umask=077 "${esp_dev}" "${mnt_path}"; then
            info "Mount failed, running fsck.vfat then retry"
            command -v fsck.vfat >/dev/null 2>&1 && fsck.vfat -a "${esp_dev}" || true
            sleep 1
            if ! mount -t "${fs_type}" -o codepage=437,iocharset=utf8,shortname=mixed,umask=077 "${esp_dev}" "${mnt_path}"; then
                error "$(printf "Failed to mount %s at %s with %s\n" "${esp_dev}" "${mnt_path}" "${fs_type}")"
                dmesg | tail -n 50 || true
                exit 1
            fi
        fi
        # Copy kernel once mounted
        info "Copying kernel to ESP"
        cp "${kernel}" "${mnt_path}/bzImage"
    fi

    unmount_recursive "${mnt_path}"
    sleep 1
}

sys_os() {
    local uname
    local os

    uname=$(uname)

    case "${uname}" in
    Darwin)
        os="macos"
        ;;
    FreeBSD)
        os="freebsd"
        ;;
    Linux)
        if ! grep '^ID=' /etc/os-release | awk -F'=' '{print $2}'\
           > /dev/null; then
            echo 1
        else
            os="$(grep '^ID=' /etc/os-release | awk -F'=' '{print $2}')"
            os="${os%$'\n'}"
        fi
        ;;
    esac

    echo "${os}"
}

sys_arch() {
    local os
    os=$(sys_os)

    local arch

    case $os in
    freebsd)
        arch=$(uname -p)
        ;;
    fedora|debian|ubuntu)
        arch=$(uname -m)
        ;;
    esac

    case "$arch" in
        aarch64)
        arch="arm64"
        ;;
        x86_64)
        arch="amd64"
        ;;
        i686)
        arch="i386"
        ;;
    esac

    echo "$arch"
}

# Add repository for a newer version of podman
podman_add_repo() {
    info "$(printf "podman: Upgrading from repo for Ubuntu %s\n" "${ubuntu_version}")"

    sudo sh -c "echo \"deb $podman_repo_url/ /\" | tee /etc/apt/sources.list.d/devel:kubic:libcontainers:unstable.list"
    sudo sh -c "curl -fsSL $podman_repo_key_url | gpg --dearmor | tee /etc/apt/trusted.gpg.d/devel_kubic_libcontainers_unstable.gpg > /dev/null"
    sudo apt update
}

# Install podman
podman_install() {
    local os
    local cmd

    os=$(sys_os)

    case "$os" in
    debian|ubuntu)
        sudo apt update -y
        # Prepare for cross-builds with --platform if we are on amd64
        if [ "amd64" = "$(sys_arch)" ]; then
            sudo apt install -y podman qemu-user-static binfmt-support
            sudo docker run --rm --privileged multiarch/qemu-user-static --reset -p yes
        fi
        ;;
    fedora)
        sudo dnf update -y
        # Prepare for cross-builds with --platform if we are on amd64
        if [ "amd64" = "$(sys_arch)" ]; then
            sudo dnf install -y podman qemu-user-static
            sudo systemctl restart systemd-binfmt
        fi
        ;;
    esac
}

