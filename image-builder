# Check if we got root privileges
# Return 0 if privileged, 1 otherwise
check_root() {
    if [ -z ${SUDO_USER+x} ]; then
        if [ $UID != "0" ]; then
            echo 1
        fi
    fi

    echo 0
}

# Check if we got root privileges
# Fail if unprivileged
check_root_fail() {
    if [ -z ${SUDO_USER+x} ]; then
        if [ $UID != "0" ]; then
            printf "\n"
            error "$(printf "Need root privileges. Please restart privileged.\nAborting..\n")"
            printf "\n"
            exit 1
        fi
    fi
}

reexec_privileged() {
    if [ "$(id -u)" != "0" ]; then
        sudo -E "$SCRIPT_PATH"/"$SCRIPT_NAME" "${args[@]}"
