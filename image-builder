filesystem() {
    local disk_file
    disk_file="${1}"
    local part_no
    part_no="${2}"
    local dev
    local fs

    loop_mount "${disk_file}"

    local ret
    ret="$(loop_device)"

    if [ 1 == "${ret}" ]; then
        dev="/dev/loop0p${part_no}"
    else
        dev="${ret}p${part_no}"
    fi

    if lsblk -f -n -ofstype "${dev}" ; then
        # Some grace time is needed for the detection not to fail
        sleep 1
        fs="$(lsblk -f -n -ofstype "${dev}")"
        if [ -z "${fs}" ]; then
            error "$(printf "Failed to determine filesystem of %s\n" "${dev}")"
            loop_unmount ""
            exit 1
        fi
    else
        error "$(printf "Failed to determine filesystem of %s\n" "${dev}")"
        loop_unmount ""
        exit 1
    fi

    loop_unmount ""

    printf "%s" "${fs}"
}

