# Download if checksum differs
# from the one supplied by URL
download_miss() {
    local download_path
    download_path="${1}"
    local file
    file="${2}"
    local csum_url
    csum_url="${3}"
    local csum_file
    csum_file="${4}"
    local download_image
    download_image=1

    cd "${download_path}" || exit 1

    # "file" is a URL (as passed by every caller) - compare/skip logic
    # needs the local file name it downloads to, not the URL itself
    local file_name
    file_name="$(basename "${file}")"

    debug "$(printf "Fetching file checksum\n")"
    download "${csum_url}" "${download_path}" "${DOWNLOAD_RETRIES}"

    local ret
    if [ -f "${download_path}/${file_name}" ]; then
        ret=$(compare_checksums "${download_path}/${csum_file}" \
                                "${download_path}/${file_name}")

        if [ "$ret" != "0" ]; then
            info "$(printf "Remote and local images differ\n")"
        else
            info "$(printf "Skipping download: Image exists\n")"
            download_image=0
        fi
    fi

    if [ 1 == "$download_image" ]; then
        download "${file}" "${download_path}" "${DOWNLOAD_RETRIES}"

        ret=$(compare_checksums "${download_path}/${csum_file}" \
                                "${download_path}/${file_name}")
        if [ "$ret" != "0" ]; then
            error "$(printf "Checksum mismatch after download: %s\n" "${file_name}")"
            exit 1
        fi
    fi
}

download() {
    local url
    url="${1}"
    local path
    path="${2}"
    local retries
    retries="${3:-1}"
    local attempt
    attempt=1
    local success
    success=0

    info "$(printf "Fetching: %s\n" "${url}")"

    # --output-dir needs a new enough cURL
    cd "${path}" || exit 1

    while [ "${attempt}" -le "${retries}" ]; do
        if curl -s -S --fail -LO "${url}"; then
            success=1
            break
        else
            if [ "${attempt}" -lt "${retries}" ]; then
                info "$(printf "Download attempt %s/%s failed; retrying..\n" "${attempt}" "${retries}")"
                sleep 2
            fi
        fi
        attempt=$((attempt+1))
    done

    if [ "${success}" -ne 1 ]; then
        error "$(printf "Failed to fetch file after %s attempt(s). Aborting..\n" "${retries}")"
        exit 1
    fi
}

create_user() {
    local user
    user="${1}"
    local path
    path="${2}"
