add_dhcp_client() {
    local mnt_path
    mnt_path="${1}"
    local target_arch
    target_arch="${2}"
    local net_device
    net_device="${3}"

    local artifact
    artifact="gokrazy-dhcp-linux-${target_arch}-${gokrazy_dhcp_release_tag}.tar.xz"
    local build_dir
    build_dir="$(mktemp -d)"

    if ! curl -fsSL -o "${build_dir}/${artifact}" \
        "${gokrazy_dhcp_repo_url}/releases/download/${gokrazy_dhcp_release_tag}/${artifact}"; then
        error "$(printf "add_dhcp_client: failed to download %s\n" "${artifact}")"
        exit 1
    fi

    tar -C "${build_dir}" -xf "${build_dir}/${artifact}"
    install -Dm755 "${build_dir}/gokrazy-dhcp" "${mnt_path}/usr/local/sbin/dhcp"
    rm -rf "${build_dir}"

    local path
    path="${mnt_path}/etc/systemd/system"

cat <<'EOF' > "${mnt_path}/usr/local/sbin/net-dhcp"
#!/bin/sh
iface="$(ls /sys/class/net | grep '^enp' | head -1)"
exec /usr/local/sbin/dhcp -interface="${iface}"
EOF
    chmod 755 "${mnt_path}/usr/local/sbin/net-dhcp"

cat <<EOF > "${path}/net-dhcp.service"
[Unit]
Description=gokrazy DHCP client
After=sys-subsystem-net-devices-${net_device}.device
Wants=sys-subsystem-net-devices-${net_device}.device

[Service]
Type=simple
ExecStartPre=/bin/ip link set dev ${net_device} up
ExecStart=/usr/local/sbin/net-dhcp

[Install]
WantedBy=multi-user.target
EOF

    mkdir -p "${path}/multi-user.target.wants"
    ln -s -f "${path}/net-dhcp.service" "${path}/multi-user.target.wants/net-dhcp.service"
}

