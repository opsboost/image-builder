    if [ -z "$disk_file" ]; then
        error "$(printf "Missing disk file.\n Please provide a disk file to use.\nAborting..")"
    fi

    create_disk "${disk_file}" "${reduce_gpt_table}"

    case "$os" in
    ubuntu|fedora)
        loop_mount_linux "${disk_file}"
        ;;
    freebsd)
        loop_mount_freebsd "${disk_file}"
        ;;
    esac

    # Create filesystems
    case "$os" in
    ubuntu|fedora)
        info "Creating file systems"
        if ! sudo mkfs.vfat "${esp_dev}"; then
            error "$(printf "Error: Failed to create filesystem\n")"
