# Write a single systemd-boot entry. BOOT_TYPE 'linux' boots a kernel
# with an optional initrd, 'efi' chainloads an EFI binary - which is how
# the BSD slots boot, through the loader taken from their own image
create_boot_entry() {
    local entry_file
    entry_file="${1}"
    local title
    title="${2}"
    local boot_type
    boot_type="${3}"
    local kernel
    kernel="${4}"
    local initrd
    initrd="${5}"
    local root_spec
    root_spec="${6}"
    local cmdline
    cmdline="${7}"

    local entry_dir
    entry_dir="$(dirname -- "${entry_file}")"
    mkdir -p "${entry_dir}"

    local options
    options=""
    if [ -n "${root_spec}" ]; then
        options="root=${root_spec}"
    fi
    if [ -n "${cmdline}" ]; then
        options="${options:+${options} }${cmdline}"
    fi

    {
        printf "title         %s\n" "${title}"

        case "${boot_type}" in
        linux)
            printf "linux         /%s\n" "${kernel}"
            if [ -n "${initrd}" ]; then
                printf "initrd        /%s\n" "${initrd}"
            fi
            ;;
        efi)
            printf "efi           /%s\n" "${kernel}"
            ;;
        *)
            error "$(printf "create_boot_entry: Unknown boot type: %s\n" "${boot_type}")"
            exit 1
            ;;
        esac

        if [ -n "${options}" ]; then
            printf "options       %s\n" "${options}"
        fi
    } > "${entry_file}"
}

# Verify a file against a checksum file, accepting both the BSD style
# "SHA256 (file) = hash" the BSDs publish and coreutils' "hash  file"
checksum_verify() {
    local csum_file
    csum_file="${1}"
    local file
    file="${2}"
    local algo
    algo="${3:-sha256}"

    if [ ! -f "${csum_file}" ]; then
        error "$(printf "checksum_verify: Missing checksum file: %s\n" "${csum_file}")"
        return 1
    fi

    local expected
    expected="$(sed -n 's/.*=[[:space:]]*\([0-9a-fA-F][0-9a-fA-F]*\)[[:space:]]*$/\1/p' \
                    "${csum_file}" | head -1)"
    if [ -z "${expected}" ]; then
        expected="$(awk '{ print $1; exit }' "${csum_file}")"
    fi

    local actual
    local os
    os="$(uname)"

    case "$os" in
    Linux)
        actual="$("${algo}sum" "${file}" | awk '{ print $1 }')"
        ;;
    Darwin|FreeBSD)
        actual="$("${algo}" -q "${file}")"
        ;;
    *)
        error "$(printf "checksum_verify: Unsupported OS: %s\n" "${os}")"
        return 1
        ;;
    esac

    expected="$(printf "%s" "${expected}" | tr '[:upper:]' '[:lower:]')"
    actual="$(printf "%s" "${actual}" | tr '[:upper:]' '[:lower:]')"

    info "$(printf "Comparing checksums\nA: %s\nB: %s\n" "${expected}" "${actual}")"

    [ -n "${expected}" ] && [ "${expected}" = "${actual}" ]
}

# Print "START_SECTOR SIZE_SECTORS" for the first partition filling a
# given role in a disk image. Reads the partition table out of the file
# itself, so it needs no loop device, and covers both the GPT type
# GUIDs and the MBR type bytes FreeBSD-derived images come with
image_partition_range() {
    local img
    img="${1}"
    local role
    role="${2}"

    local types
    case "${role}" in
    ufs)
        types="516E7CB6-6ECF-11D6-8FF8-00022D09712B a5"
        ;;
    esp)
        types="C12A7328-F81F-11D2-BA4B-00A0C93EC93B ef"
        ;;
    *)
        error "$(printf "image_partition_range: Unknown role: %s\n" "${role}")"
        return 1
        ;;
    esac

    local dump
    dump="$(sfdisk -d "${img}" 2>/dev/null)" || return 1

    local type
    for type in ${types}; do
        local line
        line="$(printf "%s\n" "${dump}" | grep -i "type=${type}\(,\|$\)" | head -1)"

        if [ -n "${line}" ]; then
            local start
            start="$(printf "%s" "${line}" | \
                     sed -n 's/.*start=[[:space:]]*\([0-9][0-9]*\).*/\1/p')"
            local size
            size="$(printf "%s" "${line}" | \
                    sed -n 's/.*size=[[:space:]]*\([0-9][0-9]*\).*/\1/p')"

            if [ -n "${start}" ] && [ -n "${size}" ]; then
                printf "%s %s" "${start}" "${size}"
                return 0
            fi
        fi
    done

    return 1
}

# Read a little endian unsigned integer of WIDTH bytes from a file at a
# byte offset. od's native word order matches the on-disk format on the
# platforms this runs on
read_uint_le() {
    local file
    file="${1}"
    local offset
    offset="${2}"
    local width
    width="${3}"

    od -An "-tu${width}" -j "${offset}" "-N${width}" "${file}" | tr -d ' \n'
}

# A FreeBSD MBR slice normally holds a BSD disklabel rather than a bare
# filesystem, so its UFS partition sits some way into the slice rather
# than at its start. Print "START_SECTOR SIZE_SECTORS", in absolute
# sectors, for the label's first UFS partition
bsd_label_ufs_range() {
    local img
    img="${1}"
    local slice_start
    slice_start="${2}"

    # The label lives in the slice's second sector
    local label
    label=$(( (slice_start + 1) * 512 ))

    # 2186691927 is 0x82564557, the disklabel magic
    if [ "2186691927" != "$(read_uint_le "${img}" "${label}" 4)" ]; then
        return 1
    fi

    local npartitions
    npartitions="$(read_uint_le "${img}" "$((label + 138))" 2)"
    if [ -z "${npartitions}" ] || [ "${npartitions}" -le 0 ]; then
        return 1
    fi

    local i
    for i in $(seq 0 "$((npartitions - 1))"); do
        local entry
        entry=$((label + 148 + i * 16))

        local size
        size="$(read_uint_le "${img}" "${entry}" 4)"
        local offset
        offset="$(read_uint_le "${img}" "$((entry + 4))" 4)"

        # p_fstype is the low byte of the word at +12, and 7 is
        # FS_BSDFFS - a UFS filesystem
        local fstype
        fstype="$(read_uint_le "${img}" "$((entry + 12))" 4)"
        fstype=$((fstype & 255))

        if [ 7 = "${fstype}" ] && [ "${size}" -gt 0 ]; then
            printf "%s %s" "$((slice_start + offset))" "${size}"
            return 0
        fi
    done

    return 1
}

# The UFS filesystem to copy out of a disk image. Descends into a BSD
# disklabel when the slice carries one, and falls back to the slice
# itself when it holds a filesystem directly
image_ufs_range() {
    local img
    img="${1}"

    local range
    range="$(image_partition_range "${img}" "ufs")" || return 1

    local slice_start
    slice_start="${range%% *}"

    local nested
    if nested="$(bsd_label_ufs_range "${img}" "${slice_start}")"; then
        info "$(printf "Found a BSD disklabel in the slice at sector %s: using its UFS partition\n" \
                       "${slice_start}")"
        printf "%s" "${nested}"
        return 0
    fi

    printf "%s" "${range}"
}

# parted's fs-type hint for a filesystem name
parted_fs_hint() {
    case "${1}" in
    vfat) echo "fat32" ;;
    *)    echo "${1}" ;;
    esac
}

# sgdisk type codes: FreeBSD UFS, Microsoft basic data, Linux filesystem
gpt_type_code() {
    case "${1}" in
    ufs)  echo "A503" ;;
    vfat) echo "0700" ;;
    *)    echo "8300" ;;
    esac
}

# GPT layout: p1 is a small reserved area, p2 the shared ESP, then one
# partition per slot that needs a filesystem
create_disk_parts_gpt() {
    local file_disk
    file_disk="${1}"

    parted -s "${file_disk}" mklabel gpt
    parted -s "${file_disk}" mkpart reserved 1MiB 2MiB

    local esp_start
    esp_start=3
    local esp_end
    esp_end=$((esp_start + comp_esp_size))

    parted -s "${file_disk}" mkpart esp fat32 "${esp_start}MiB" "${esp_end}MiB"
    parted -s "${file_disk}" set 2 boot on
    sgdisk -t 2:EF00 "${file_disk}" >/dev/null

    local start
    start="${esp_end}"

    local i
    for i in "${!comp_name[@]}"; do
        if [ 0 = "${comp_part[$i]}" ]; then
            continue
        fi

        local end
        if [ "rest" = "${comp_size[$i]}" ]; then
            end="100%"
        else
            end="$((start + comp_size[i]))MiB"
        fi

        parted -s "${file_disk}" mkpart "${comp_name[$i]}" \
                                        "$(parted_fs_hint "${comp_fs[$i]}")" \
                                        "${start}MiB" "${end}"
        sgdisk -t "${comp_part[$i]}:$(gpt_type_code "${comp_fs[$i]}")" \
               "${file_disk}" >/dev/null

        if [ "rest" != "${comp_size[$i]}" ]; then
            start=$((start + comp_size[i]))
        fi
    done

    parted -s "${file_disk}" print
}

#
# Image composition
#
# An image is described as an ordered list of slots. A slot is one
# bootable system: where its rootfs comes from, the partition holding
# it, and the kernel, initrd and cmdline that boot it. All slots share
# the single ESP, which carries every kernel and boot entry.
#
# bash has no nested containers, so slots live in parallel arrays
# indexed by slot number, filled in by composition_load
comp_name=()
comp_provider=()
comp_provider_arg=()
comp_fs=()
comp_size=()
comp_part=()
comp_kernel_src=()
comp_kernel=()
comp_initrd_src=()
comp_initrd=()
comp_cmdline=()
comp_boot_type=()

# Total image size in MiB. Set by composition_load for targets that
# want a fixed size rather than one derived from their slots
comp_disk_size=""
comp_esp_size=256

# Destinations already copied to the ESP, so slots sharing a kernel copy
# it once. A newline separated list rather than an associative array,
# which bash 3 does not have
esp_installed=""

composition_reset() {
    comp_name=()
    comp_provider=()
    comp_provider_arg=()
    comp_fs=()
    comp_size=()
    comp_part=()
    comp_kernel_src=()
    comp_kernel=()
    comp_initrd_src=()
    comp_initrd=()
    comp_cmdline=()
    comp_boot_type=()
    comp_disk_size=""
    comp_esp_size=256
    esp_installed=""
}

# composition_add NAME PROVIDER PROVIDER_ARG FS SIZE_MIB KERNEL_SRC \
#                 KERNEL INITRD_SRC INITRD CMDLINE BOOT_TYPE
#
# FS 'none' gives the slot no partition, for a system that runs
# entirely from its initramfs. SIZE_MIB 'rest' extends the partition to
# the end of the disk. BOOT_TYPE is one of linux, efi or none
composition_add() {
    comp_name+=("${1}")
    comp_provider+=("${2}")
    comp_provider_arg+=("${3}")
    comp_fs+=("${4}")
    comp_size+=("${5}")
    comp_kernel_src+=("${6}")
    comp_kernel+=("${7}")
    comp_initrd_src+=("${8}")
    comp_initrd+=("${9}")
    comp_cmdline+=("${10}")
    comp_boot_type+=("${11}")
    comp_part+=(0)
}

comp_count() {
    echo "${#comp_name[@]}"
}

# Assign partition numbers. p1 is reserved and p2 is the ESP, so slots
# needing a filesystem start at p3. Slots without one keep 0 and are
# skipped when partitioning
composition_finalize() {
    local n
    n=3

    local i
    for i in "${!comp_name[@]}"; do
        if [ "none" = "${comp_fs[$i]}" ]; then
            comp_part[$i]=0
        else
            comp_part[$i]="${n}"
            n=$((n+1))
        fi
    done
}

composition_disk_size_mib() {
    if [ -n "${comp_disk_size}" ]; then
        echo "${comp_disk_size}"
        return 0
    fi

    # 3MiB ahead of the ESP, plus a 4MiB tail for the backup GPT
    local total
    total=$((3 + comp_esp_size + 4))

    local i
    for i in "${!comp_name[@]}"; do
        if [ 0 = "${comp_part[$i]}" ] || [ "rest" = "${comp_size[$i]}" ]; then
            continue
        fi
        total=$((total + comp_size[i]))
    done

    echo "${total}"
}

composition_show() {
    info "$(printf "Image composition (%s MiB, %s MiB esp):\n" \
                   "$(composition_disk_size_mib)" "${comp_esp_size}")"

    local i
    for i in "${!comp_name[@]}"; do
        info "$(printf "  slot %s  %-20s provider=%-9s fs=%-5s part=%-2s size=%-6s kernel=%-22s initrd=%-26s boot=%s\n" \
                       "${i}" \
                       "${comp_name[$i]}" \
                       "${comp_provider[$i]}" \
                       "${comp_fs[$i]}" \
                       "${comp_part[$i]}" \
                       "${comp_size[$i]}" \
                       "${comp_kernel[$i]:--}" \
                       "${comp_initrd[$i]:--}" \
                       "${comp_boot_type[$i]}")"
    done
}

# Describe a build target as a set of slots
composition_load() {
    local build_target
    build_target="${1}"
    local target_arch
    target_arch="${2}"

    composition_reset

    local kernel_file
    local kernel_src

    case "$build_target" in
    gentoo-containeros|gentoo-sway|gentoo-sway-virt|gentoo-sway-pine64|gentoo-k3s)
        local target_flavour
        target_flavour=${build_target#*gentoo-}
        target_flavour=${target_flavour%-pine64}

        if [ "gentoo-sway-pine64" = "${build_target}" ]; then
            # Real Allwinner hardware, not the QEMU virt machine - no
            # virtio, needs the pine64-specific kernel build
            kernel_file="Image-pine64"
        else
            kernel_file="$(kernel_file_for_arch "${target_arch}")"
        fi

        # A fixed 16GiB disk with a single partition filling it, as
        # this target had before it was described as a composition.
        # Partition boundaries now land on MiB rather than the MB that
        # unitless parted arguments meant, which suits the 4096-byte
        # sector size the xfs below is created with
        comp_disk_size=16384

        composition_add "gentoo-${target_flavour}" \
                        "gentoo" \
                        "${target_flavour}" \
                        "xfs" \
                        "rest" \
                        "${kernel_file}-latest" \
                        "${kernel_file}" \
                        "" \
                        "" \
                        "${linux_cmdline_default}" \
                        "linux"
        ;;
    containeros-virt)
        # One of its slots is NomadBSD, so the whole target is limited to
        # the architectures NomadBSD is published for
        nomadbsd_require_arch "${target_arch}" "containeros-virt"

        kernel_file="$(kernel_file_for_arch "${target_arch}")"
        kernel_src="${kernel_file}-latest"

        # The ESP holds a Linux kernel, the u-root initramfs and
        # NomadBSD's EFI loader rather than a single kernel
        comp_esp_size=512

        composition_add "gentoo-containeros" \
                        "gentoo" \
                        "containeros" \
                        "xfs" \
                        "10240" \
                        "${kernel_src}" \
                        "${kernel_file}" \
                        "" \
                        "" \
                        "${linux_cmdline_default}" \
                        "linux"

        composition_add "nomadbsd" \
                        "nomadbsd" \
                        "${target_arch}" \
                        "ufs" \
                        "6144" \
                        "${nomadbsd_loader_file}" \
                        "EFI/nomadbsd/loader.efi" \
                        "" \
                        "" \
                        "" \
                        "efi"

        # u-root runs from its initramfs alone, so it gets no partition
        # and boots the kernel the Gentoo slot already put on the ESP
        composition_add "u-root" \
                        "u-root" \
                        "${target_arch}" \
                        "none" \
                        "0" \
                        "${kernel_src}" \
                        "${kernel_file}" \
                        "initramfs-${target_arch}.cpio" \
                        "initramfs-${target_arch}.cpio" \
                        "${linux_cmdline_console}" \
                        "linux"
        ;;
    nomadbsd)
        nomadbsd_require_arch "${target_arch}" "nomadbsd"

        comp_esp_size=64

        composition_add "nomadbsd" \
                        "nomadbsd" \
                        "${target_arch}" \
                        "ufs" \
                        "6144" \
                        "${nomadbsd_loader_file}" \
                        "EFI/nomadbsd/loader.efi" \
                        "" \
                        "" \
                        "" \
                        "efi"
        ;;
    *)
        # Keeps targets that partition a disk without describing one -
        # alma - on the layout they had before compositions existed
        info "$(printf "composition_load: No composition for '%s', using a single xfs rootfs\n" \
                       "${build_target}")"
        comp_disk_size=16384

        composition_add "${build_target}" \
                        "none" \
                        "" \
                        "xfs" \
                        "rest" \
                        "" \
                        "" \
                        "" \
                        "" \
                        "" \
                        "none"
        ;;
    esac

    composition_finalize
}

# Fetch and stage everything the slots need before the disk image is
# created, so a failed download does not leave a half-built image
composition_fetch() {
    local download_path
    download_path="${1}"
    local target_arch
    target_arch="${2}"

    local i
    for i in "${!comp_name[@]}"; do
        case "${comp_provider[$i]}" in
        gentoo)
            info "Fetching kernel"
            download_miss "${download_path}" \
                          "${kernel_repo_url}/${comp_kernel_src[$i]}" \
                          "${kernel_repo_url}/${comp_kernel_src[$i]}.sha384" \
                          "${comp_kernel_src[$i]}.sha384"

            gentoo_fetch_stage3 "${target_arch}"
            gentoo_fetch_stage4 "${comp_provider_arg[$i]}" "${target_arch}" "latest"
            ;;
        nomadbsd)
            nomadbsd_fetch "${download_path}" "${comp_provider_arg[$i]}"
            nomadbsd_stage_loader "${download_path}" "${comp_provider_arg[$i]}"
            ;;
        u-root)
            u_root_fetch "${download_path}" "${comp_provider_arg[$i]}"
            ;;
        esac

        # Catch a slot whose initramfs neither its provider fetched nor
        # a local build produced, before the disk is touched
        local initrd_src
        initrd_src="${comp_initrd_src[$i]}"
        if [ -n "${initrd_src}" ] && \
           [ ! -f "${initrd_src}" ] && \
           [ ! -f "${download_path}/${initrd_src}" ]; then
            error "$(printf "Missing initramfs for slot '%s': %s\n" \
                            "${comp_name[$i]}" "${initrd_src}")"
            error "$(printf "Build it first:\n\n  # image-builder build u-root %s\n" \
                            "${target_arch}")"
            exit 1
        fi
    done
}

# Create each slot's filesystem. UFS slots are skipped: their
# filesystem is copied in whole from an upstream image, which would
# overwrite anything created here
composition_mkfs() {
    local i
    for i in "${!comp_name[@]}"; do
        if [ 0 = "${comp_part[$i]}" ]; then
            continue
        fi

        local dev
        dev="$(part_dev "${comp_part[$i]}")"

        case "${comp_fs[$i]}" in
        xfs)
            if ! mkfs.xfs -s size=4096 "${dev}"; then
                error "$(printf "Error: Failed to create filesystem on %s\n" "${dev}")"
                exit 1
            fi
            ;;
        vfat)
            if ! mkfs.vfat "${dev}"; then
                error "$(printf "Error: Failed to create filesystem on %s\n" "${dev}")"
                exit 1
            fi
            ;;
        ufs)
            info "$(printf "Skipping mkfs on %s: its UFS filesystem is copied in whole\n" "${dev}")"
            ;;
        *)
            error "$(printf "composition_mkfs: Unsupported filesystem: %s\n" "${comp_fs[$i]}")"
            exit 1
            ;;
        esac
    done
}

# Populate every slot that has a partition, using the slot's provider
install_rootfs_slots() {
    local mnt_path
    mnt_path="${1}"
    local src_path
    src_path="${2}"

    local i
    for i in "${!comp_name[@]}"; do
        if [ 0 = "${comp_part[$i]}" ]; then
            continue
        fi

        local dev
        dev="$(part_dev "${comp_part[$i]}")"

        info "$(printf "Installing rootfs for slot %s (%s) to %s\n" \
                       "${i}" "${comp_name[$i]}" "${dev}")"

        case "${comp_provider[$i]}" in
        gentoo)
            install_rootfs "${dev}" "${mnt_path}" "${comp_fs[$i]}"
            ;;
        nomadbsd)
            nomadbsd_install_rootfs "${dev}" \
                                    "${src_path}" \
                                    "${comp_provider_arg[$i]}"
            ;;
        none|u-root)
            info "$(printf "Slot %s installs no rootfs, leaving %s empty\n" \
                           "${comp_name[$i]}" "${dev}")"
            ;;
        *)
            error "$(printf "install_rootfs_slots: Unknown rootfs provider: %s\n" \
                            "${comp_provider[$i]}")"
            exit 1
            ;;
        esac

        verify_filesystem "${dev}" "$(printf "install_rootfs %s" "${comp_name[$i]}")"
    done
}

# Map a target arch onto the token NomadBSD image names use
nomadbsd_arch() {
    local target_arch
    target_arch="${1}"

    case "${target_arch}" in
    amd64|x86_64) echo "amd64" ;;
    i386|x86)     echo "i386" ;;
    mac)          echo "mac" ;;
    *)            echo "" ;;
    esac
}

# Refuse a NomadBSD slot on an architecture upstream does not build,
# at composition time rather than part way through a build. An
# explicitly supplied image is the caller's business, so it passes
nomadbsd_require_arch() {
    local target_arch
    target_arch="${1}"
    local context
    context="${2}"

    if [ -n "${NOMADBSD_IMAGE}" ]; then
        return 0
    fi

    if [ -n "$(nomadbsd_arch "${target_arch}")" ]; then
        return 0
    fi

    error "$(printf "%s: NomadBSD publishes no %s image\n" "${context}" "${target_arch}")"
    error "Upstream builds amd64, i386 and mac only; there is no arm64 image"
    error "$(printf "Compose %s for one of those, or set NOMADBSD_IMAGE to a\n" "${context}")"
    error "locally supplied image to override this"
    exit 1
}

nomadbsd_image_file() {
    local nomad_arch
    nomad_arch="${1}"

    printf "nomadbsd-%s.%s.%s.img" "${nomadbsd_version}" \
                                   "${nomad_arch}" \
                                   "${nomadbsd_filesystem}"
}

# Where the image to compose from lives. NOMADBSD_IMAGE overrides the
# upstream one, which is the only way to get an architecture upstream
# does not publish
nomadbsd_image_path() {
    local src_path
    src_path="${1}"
    local target_arch
    target_arch="${2}"

    if [ -n "${NOMADBSD_IMAGE}" ]; then
        printf "%s" "${NOMADBSD_IMAGE}"
        return 0
    fi

    printf "%s/%s" "${src_path}" \
                   "$(nomadbsd_image_file "$(nomadbsd_arch "${target_arch}")")"
}

nomadbsd_fetch() {
    local download_path
    download_path="${1}"
    local target_arch
    target_arch="${2}"

    if [ -n "${NOMADBSD_IMAGE}" ]; then
        if [ ! -f "${NOMADBSD_IMAGE}" ]; then
            error "$(printf "NomadBSD: NOMADBSD_IMAGE does not exist: %s\n" \
                            "${NOMADBSD_IMAGE}")"
            exit 1
        fi
        info "$(printf "NomadBSD: Using NOMADBSD_IMAGE: %s\n" "${NOMADBSD_IMAGE}")"
        return 0
    fi

    local nomad_arch
    nomad_arch="$(nomadbsd_arch "${target_arch}")"

    if [ -z "${nomad_arch}" ]; then
        nomadbsd_require_arch "${target_arch}" "NomadBSD"
    fi

    local img_file
    img_file="$(nomadbsd_image_file "${nomad_arch}")"
    local compressed_file
    compressed_file="${img_file}.lzma"

    if [ -f "${download_path}/${img_file}" ]; then
        info "$(printf "NomadBSD: Image exists, not fetching again: %s\n" "${img_file}")"
        return 0
    fi

    # download exits on failure, so run it in a subshell to say which
    # architecture is missing rather than just that a fetch failed.
    # nomadbsd.org carries amd64, i386 and mac; anything else needs
    # NOMADBSD_REPO_URL or NOMADBSD_IMAGE
    if [ ! -f "${download_path}/${compressed_file}" ]; then
        if ! ( download "${nomadbsd_repo_url}/${compressed_file}" \
                        "${download_path}" \
                        "${DOWNLOAD_RETRIES}" ); then
            error "$(printf "NomadBSD: No %s image at %s\n" \
                            "${nomad_arch}" "${nomadbsd_repo_url}")"
            error "$(printf "Looked for %s\n" "${compressed_file}")"
            error "Set NOMADBSD_REPO_URL to a mirror carrying it, or"
            error "NOMADBSD_IMAGE to an already built image"
            exit 1
        fi
    fi

    download "${nomadbsd_repo_url}/${compressed_file}.sha256" \
             "${download_path}" \
             "${DOWNLOAD_RETRIES}"

    info "NomadBSD: Verifying checksum"
    if ! checksum_verify "${download_path}/${compressed_file}.sha256" \
                         "${download_path}/${compressed_file}" \
                         "sha256"; then
        error "$(printf "NomadBSD: Checksum mismatch: %s\n" "${compressed_file}")"
        exit 1
    fi

    info "$(printf "NomadBSD: Decompressing %s\n" "${compressed_file}")"
    if ! xz -d -k -f "${download_path}/${compressed_file}"; then
        error "NomadBSD: Failed to decompress image"
        exit 1
    fi
}

# NomadBSD boots through FreeBSD's EFI loader. Take it out of the
# image's own ESP so a systemd-boot entry can chainload it
nomadbsd_stage_loader() {
    local src_path
    src_path="${1}"
    local target_arch
    target_arch="${2}"

    local dest
    dest="${src_path}/${nomadbsd_loader_file}"

    if [ -f "${dest}" ]; then
        info "$(printf "NomadBSD: EFI loader already staged: %s\n" "${dest}")"
        return 0
    fi

    local src_img
    src_img="$(nomadbsd_image_path "${src_path}" "${target_arch}")"

    local range
    range="$(image_partition_range "${src_img}" "esp")"
    if [ -z "${range}" ]; then
        error "$(printf "NomadBSD: Found no ESP in %s\n" "${src_img}")"
        sfdisk -d "${src_img}" || true
        exit 1
    fi

    local start_sector
    start_sector="${range%% *}"
    local size_sectors
    size_sectors="${range##* }"

    local esp_img
    esp_img="${src_path}/nomadbsd-esp.img"
    local esp_mnt
    esp_mnt="${src_path}/nomadbsd-esp"

    info "$(printf "NomadBSD: Reading the image's ESP (%s MiB)\n" \
                   "$((size_sectors / 2048))")"

    if ! dd if="${src_img}" of="${esp_img}" bs=4M \
            iflag=skip_bytes,count_bytes \
            skip="$((start_sector * 512))" \
            count="$((size_sectors * 512))"; then
        error "NomadBSD: Failed to read the image's ESP"
        rm -f "${esp_img}"
        exit 1
    fi

    mkdir -p "${esp_mnt}"

    # Attach and detach the loop device explicitly rather than leaving
    # it to mount's autoclear: this runs before the image being built
    # claims a device, and loop_mount_linux refuses to continue if one
    # is still held when it starts
    local loop_dev
    loop_dev="$(losetup --find --show --read-only "${esp_img}")"

    if [ -z "${loop_dev}" ]; then
        error "$(printf "NomadBSD: Failed to attach the image's ESP: %s\n" "${esp_img}")"
        rm -f "${esp_img}"
        exit 1
    fi

    if ! mount -t vfat -o ro "${loop_dev}" "${esp_mnt}"; then
        error "$(printf "NomadBSD: Failed to mount the image's ESP: %s\n" "${loop_dev}")"
        losetup -d "${loop_dev}" || true
        rm -f "${esp_img}"
        exit 1
    fi

    # The binary is BOOTAA64.EFI on arm64 and BOOTX64.EFI on amd64, and
    # vfat is case insensitive, so search for it rather than guess
    local loader
    loader="$(find "${esp_mnt}" \
                   \( -iname 'boot*.efi' -o -iname 'loader.efi' \) \
                   -type f | head -1)"

    if [ -n "${loader}" ]; then
        info "$(printf "NomadBSD: Staging EFI loader %s\n" "${loader}")"
        cp "${loader}" "${dest}"
    else
        error "NomadBSD: Found no EFI loader on the image's ESP"
        find "${esp_mnt}" || true
    fi

    umount "${esp_mnt}"
    losetup -d "${loop_dev}" || true
    rmdir "${esp_mnt}" || true
    rm -f "${esp_img}"

    if [ ! -f "${dest}" ]; then
        exit 1
    fi
}

# NomadBSD ships a whole disk image rather than a rootfs tarball, and
# Linux can not write UFS, so move the filesystem across as a block
# range instead of copying files into a mounted UFS
nomadbsd_install_rootfs() {
    local dest_dev
    dest_dev="${1}"
    local src_path
    src_path="${2}"
    local target_arch
    target_arch="${3}"

    local src_img
    src_img="$(nomadbsd_image_path "${src_path}" "${target_arch}")"

    if [ ! -f "${src_img}" ]; then
        error "$(printf "NomadBSD: Missing image: %s\n" "${src_img}")"
        exit 1
    fi

    local range
    range="$(image_ufs_range "${src_img}")"
    if [ -z "${range}" ]; then
        error "$(printf "NomadBSD: Found no UFS filesystem in %s\n" "${src_img}")"
        sfdisk -d "${src_img}" || true
        exit 1
    fi

    local start_sector
    start_sector="${range%% *}"
    local size_sectors
    size_sectors="${range##* }"

    local src_bytes
    src_bytes=$((size_sectors * 512))
    local dest_bytes
    dest_bytes="$(blockdev --getsize64 "${dest_dev}")"

    if [ "${dest_bytes}" -lt "${src_bytes}" ]; then
        error "$(printf "NomadBSD: Slot %s holds %s bytes but the UFS filesystem needs %s\n" \
                        "${dest_dev}" "${dest_bytes}" "${src_bytes}")"
        error "Raise the slot's size in composition_load"
        exit 1
    fi

    info "$(printf "NomadBSD: Copying UFS filesystem (%s MiB) to %s\n" \
                   "$((src_bytes / 1048576))" "${dest_dev}")"

    if ! dd if="${src_img}" of="${dest_dev}" bs=4M \
            iflag=skip_bytes,count_bytes \
            skip="$((start_sector * 512))" \
            count="${src_bytes}" \
            status=progress conv=fsync; then
        error "NomadBSD: Failed to copy the UFS filesystem"
        exit 1
    fi

    sync
}

# NomadBSD's build system runs on FreeBSD and takes ARCH=amd64|i386|mac
nomadbsd_build() {
    local target_arch
    target_arch="${1}"

    local os
    os="$(sys_os)"
    if [ "freebsd" != "${os}" ]; then
        error "$(printf "NomadBSD: Its build system runs on FreeBSD only (host is %s)\n" \
                        "${os}")"
        exit 1
    fi

    local nomad_arch
    nomad_arch="$(nomadbsd_arch "${target_arch}")"
    if [ -z "${nomad_arch}" ]; then
        error "$(printf "NomadBSD: Can not build for %s: ARCH takes amd64, i386 or mac\n" \
                        "${target_arch}")"
        exit 1
    fi

    info "$(printf "NomadBSD: Building a %s %s image\n" \
                   "${nomad_arch}" "${nomadbsd_filesystem}")"

    git clone --depth 1 "${nomadbsd_source_url}"
    cd NomadBSD
    ./build -a "${nomad_arch}" -f "${nomadbsd_filesystem}" all
}

create_disk() {
    local file_disk
    file_disk="${1}"
    local reduce_gpt_table
    reduce_gpt_table="${2}"

    local os
    os="$(sys_os)"

    local disk_size_mib
    disk_size_mib="$(composition_disk_size_mib)"

    info "$(printf "Creating disk file %s (%s MiB)..\n" "${file_disk}" "${disk_size_mib}")"
    dd if=/dev/zero of="${file_disk}" bs=1M count="${disk_size_mib}" status=progress

    case "$os" in
    ubuntu|fedora)
        create_disk_parts_gpt "${file_disk}"

        if [ -n "${reduce_gpt_table}" ]; then
            # A default GPT reserves 128 entries (16KiB, up to byte
            # 17408) for the partition array, which overlaps the byte
            # 8192 offset a pine64 U-Boot SPL gets dd'd into. Only a
            # handful of partitions are ever used here, so 8 entries
            # (1KiB) is plenty and clears that offset with room to spare
            info "Shrinking GPT partition entry table to clear the pine64 U-Boot SPL offset"
            sgdisk --resize-table=8 "${file_disk}"
        fi
        ;;
    freebsd|macos)
        loop_mount_freebsd "${file_disk}"
        gpart create -s gpt /dev/md99
        gpart add -t efi -s "${comp_esp_size}m" -l efi0 /dev/md99
        gpart add -t linux-data -l rootfs0 /dev/md99
        loop_unmount_freebsd 99
        ;;
    *)
        error "$(printf "Unsupported OS for create_disk: %s\n" "${os}")"
        error "Aborting.."
        exit 1
        ;;
    esac
}

loop_exists() {
    [ "/dev/loop0" != "$(losetup -f)" ]
}

# Returns the last created loop device
# or 1 if none exists
loop_device() {
    local loop_dev
    loop_dev="$(losetup -f)"

    if [ "/dev/loop0" == "${loop_dev}" ]; then
        echo 1
    else
        read -r nloop_dev <<<"${loop_dev//[^0-9]/ }"
        local n
        n=$((nloop_dev-1))
        echo "/dev/loop${n}"
    fi
}

# Partition device for a partition number. loop_mount_linux asserts
# that images are attached to loop0, so this stays in step with it
part_dev() {
    local part_no
    part_no="${1}"

    echo "/dev/loop0p${part_no}"
}

esp() {
    part_dev 2
}

# The first rootfs partition. Compositions with several of them address
# each slot's partition through part_dev instead
rootfs() {
    part_dev 3
}

# Set up loop mount
loop_mount() {
    local disk_file
    disk_file="${1}"
    local os
    os=$(sys_os)

    case "$os" in
    fedora|ubuntu)
        loop_mount_linux "${disk_file}"
        ;;
    macos)
        loop_mount_macos "${disk_file}"
        ;;
    freebsd)
        loop_mount_freebsd "${disk_file}"
        ;;
    esac
}

loop_mount_macos() {
    local loop_device
    loop_device="${1}"

    printf "Loop mounting: %s\n" "${loop_device}"
}

loop_mount_freebsd() {
    local disk_file
    disk_file="${1}"

    r="$(mdconfig -l)"

    if ! [ "$r" == "" ]; then
        error "A loop mount exists"
        exit 1
    fi

    info "$(printf "Mounting %s" "${disk_file}")"
    mdconfig -a -t vnode -f "${disk_file}" -u 99
}

# Set up loop mount
loop_mount_linux() {
    local disk_file
    disk_file="${1}"

    printf "Loop mounting %s\n" "${disk_file}"

    local existing
    existing="$(losetup -j "${disk_file}" -O NAME --noheadings 2>/dev/null | head -1)"
    existing="$(trim "${existing}")"

    if [ -n "${existing}" ]; then
        if [ "/dev/loop0" != "${existing}" ]; then
            error "$(printf "loop_mount: %s is attached to %s, but this tool assumes /dev/loop0\n" \
                            "${disk_file}" "${existing}")"
            losetup -l
            exit 1
        fi
        printf "Reusing loop device %s for %s\n" "${existing}" "${disk_file}"
        return 0
    fi

    if loop_exists; then
        local loop_dev
        loop_dev="$(loop_device)"
        local mounts
        mounts="$(loop_mounts)"

        printf "\n"
        printf "Warning: A loop device already exists!\n\n"

        if [ "" != "${mounts}" ]; then
            printf "Remove loop mounts to proceed:\n"
            printf "%s\n\n" "${mounts}"
        fi

        printf "Remove existing loop devices to poceed:\n"
        printf "%s\n\n" "${loop_dev}"
        printf " # losetup -D\n\n"
        losetup -l
        printf "\nAborting..\n"
        exit 1
    fi

    modprobe loop

    if ! sudo losetup -P --direct-io=on -f "${disk_file}"; then
        info "$(printf "loop_mount: --direct-io=on rejected, retrying buffered\n")"
        if ! sudo losetup -P -f "${disk_file}"; then
            error "$(printf "Failed to loop mount %s\n" "${disk_file}")"
            dmesg
            exit 1
        fi
    fi
}

loop_unmount() {
    local disk_file
    disk_file="$1"

    os="$(sys_os)"

    case "$os" in
    debian|ubuntu|fedora)
        loop_unmount_linux
        ;;
    freebsd)
        loop_unmount_freebsd "${disk_file}"
        ;;
    esac
}

# FreeBSD: Tear down loop mount
loop_unmount_freebsd() {
    mdconfig -d -u "${1}"
}

# Linux: Tear down loop mount
loop_unmount_linux() {
    sync
    losetup -D
}

# Returns active loop mounts
loop_mounts() {
    local mounts
    mounts="$(mount | grep loop | awk '{print $1}')"
    echo "${mounts}"
}


install_bootloader_u_boot() {
    local img
    local img="${1}"
    local dev
    local dev="${2}"

    if dd if="${img}" of="${dev}" bs=1024 seek=8; then
        echo 0
    else
        echo 1
    fi
}

install_bootctl() {
    sudo apt-get update
    sudo apt-get install systemd-boot
}

# Mount the ESP, repairing it once if the first attempt fails
esp_mount() {
    local esp_dev
    esp_dev="${1}"
    local mnt_path
    mnt_path="${2}"

    local opts
    opts="codepage=437,iocharset=utf8,shortname=mixed,umask=077"

    if [ -z "${esp_dev}" ]; then
        error "esp_mount: Missing ESP device"
        exit 1
    fi

    if [ ! -b "${esp_dev}" ] && [ ! -c "${esp_dev}" ]; then
        error "$(printf "esp_mount: ESP device does not exist: %s\n" "${esp_dev}")"
        lsblk -f || true
        exit 1
    fi

    mkdir -p "${mnt_path}"
    chmod 700 "${mnt_path}" || true

    if findmnt -rno TARGET "${mnt_path}" >/dev/null 2>&1; then
        info "$(printf "ESP already mounted at %s\n" "${mnt_path}")"
        return 0
    fi

    if mount -t vfat -o "${opts}" "${esp_dev}" "${mnt_path}"; then
        return 0
    fi

    info "Mount failed, running fsck.vfat then retrying"
    command -v fsck.vfat >/dev/null 2>&1 && fsck.vfat -a "${esp_dev}" || true
    sleep 1

    if ! mount -t vfat -o "${opts}" "${esp_dev}" "${mnt_path}"; then
        error "$(printf "Failed to mount esp %s at %s\n" "${esp_dev}" "${mnt_path}")"
        dmesg | tail -n 50 || true
        exit 1
    fi
}

install_bootloader_efi() {
    local esp_dev
    esp_dev="${1}"
    local mnt_path
    mnt_path="${2}"

    info "Installing bootloader to ESP"
    reexec_privileged

    # Ensure bootctl is available; install it on Ubuntu if missing
    # (e.g. if run from a github action)
    if ! command -v bootctl >/dev/null 2>&1; then
        local os
        os="$(sys_os)"
        if [ "ubuntu" = "${os}" ]; then
            info "bootctl not found: Installing on Ubuntu"
            install_bootctl
        fi
    fi

    esp_mount "${esp_dev}" "${mnt_path}"

    printf "\n"
    printf "Creating esp content at path %s..\n" "${mnt_path}"
    bootctl --esp-path="${mnt_path}" install

    # Fix random-seed permissions warnings from bootctl
    chmod 700 "${mnt_path}" || true
    if [ -d "${mnt_path}/loader" ]; then
        find "${mnt_path}/loader" -maxdepth 1 -type f -name "random-seed" -exec chmod 600 {} \; 2>/dev/null || true
        find "${mnt_path}/loader" -maxdepth 1 -type f -name ".#bootctlrandom-seed*" -exec chmod 600 {} \; 2>/dev/null || true
    fi

    printf "\n"
    ls -al "${mnt_path}"
    printf "\n"

    unmount_recursive "${mnt_path}"
    sleep 3
}

# Copy one file onto the mounted ESP, skipping destinations already
# written so slots sharing a kernel do not copy it twice
esp_install_file() {
    local src_path
    src_path="${1}"
    local src
    src="${2}"
    local mnt_path
    mnt_path="${3}"
    local dest
    dest="${4}"

    if [ -z "${src}" ] || [ -z "${dest}" ]; then
        return 0
    fi

    if printf "%s" "${esp_installed}" | grep -qxF "${dest}"; then
        return 0
    fi

    local src_file
    if [ -f "${src}" ]; then
        src_file="${src}"
    else
        src_file="${src_path}/${src}"
    fi

    if [ ! -f "${src_file}" ]; then
        error "$(printf "esp_install_file: Missing source file: %s\n" "${src_file}")"
        unmount_recursive "${mnt_path}"
        exit 1
    fi

    mkdir -p "$(dirname -- "${mnt_path}/${dest}")"

    info "$(printf "Installing %s to ESP as /%s\n" "${src_file}" "${dest}")"
    if ! cp "${src_file}" "${mnt_path}/${dest}"; then
        error "$(printf "esp_install_file: Failed to copy %s to ESP\n" "${src_file}")"
        unmount_recursive "${mnt_path}"
        exit 1
    fi

    esp_installed="$(printf "%s\n%s" "${esp_installed}" "${dest}")"
}

# Put every slot's kernel and initrd on the ESP under its own name, so
# one image can boot several systems
install_kernels() {
    local esp_dev
    esp_dev="${1}"
    local mnt_path
    mnt_path="${2}"
    local src_path
    src_path="${3}"

    info "Installing kernels"
    reexec_privileged
    modprobe vfat || true

    esp_mount "${esp_dev}" "${mnt_path}"

    local i
    for i in "${!comp_name[@]}"; do
        esp_install_file "${src_path}" "${comp_kernel_src[$i]}" \
                         "${mnt_path}" "${comp_kernel[$i]}"
        esp_install_file "${src_path}" "${comp_initrd_src[$i]}" \
                         "${mnt_path}" "${comp_initrd[$i]}"
    done

    printf "\n"
    ls -alR "${mnt_path}"
    printf "\n"

    unmount_recursive "${mnt_path}"
    sleep 1
}

# Write one boot entry per slot plus a loader.conf defaulting to the
# first of them
install_boot_entries() {
    local esp_dev
    esp_dev="${1}"
    local mnt_path
    mnt_path="${2}"

    info "Installing boot entries to ESP"
    reexec_privileged

    esp_mount "${esp_dev}" "${mnt_path}"

    local default_entry
    default_entry=""

    local i
    for i in "${!comp_name[@]}"; do
        if [ "none" = "${comp_boot_type[$i]}" ]; then
            continue
        fi

        local entry_id
        entry_id="${comp_name[$i]}"
        local entry_file
        entry_file="${mnt_path}/loader/entries/${entry_id}.conf"

        # A Linux slot needs to be told its root filesystem; an EFI
        # loader finds its own
        local root_spec
        root_spec=""
        if [ "linux" = "${comp_boot_type[$i]}" ] && [ 0 != "${comp_part[$i]}" ]; then
            local part
            part="$(part_dev "${comp_part[$i]}")"
            local partuuid
            partuuid="$(blkid -o value -s PARTUUID "${part}")"
            if [ -z "${partuuid}" ]; then
                error "$(printf "install_boot_entries: Failed to read PARTUUID of %s\n" \
                                "${part}")"
                unmount_recursive "${mnt_path}"
                exit 1
            fi
            root_spec="PARTUUID=${partuuid}"
        fi

        create_boot_entry "${entry_file}" \
                          "${entry_id}" \
                          "${comp_boot_type[$i]}" \
                          "${comp_kernel[$i]}" \
                          "${comp_initrd[$i]}" \
                          "${root_spec}" \
                          "${comp_cmdline[$i]}"

        if [ -z "${default_entry}" ]; then
            default_entry="${entry_id}"
        fi

        info "$(printf "Boot entry %s:\n" "${entry_id}")"
        cat "${entry_file}"
        printf "\n"
    done

    if [ -z "${default_entry}" ]; then
        info "No bootable slots: not writing loader.conf"
    else
        cat << EOF > "${mnt_path}/loader/loader.conf"
default ${default_entry}.conf
timeout 5
console-mode keep
editor no
EOF
        info "$(printf "Default boot entry: %s\n" "${default_entry}")"
    fi

    unmount_recursive "${mnt_path}"
    sleep 1
}

sys_os() {
    local uname
    local os

    uname=$(uname)

    case "${uname}" in
    Darwin)
        os="macos"
        ;;
    FreeBSD)
        os="freebsd"
        ;;
    Linux)
        if ! grep '^ID=' /etc/os-release | awk -F'=' '{print $2}'\
           > /dev/null; then
            echo 1
        else
            os="$(grep '^ID=' /etc/os-release | awk -F'=' '{print $2}')"
            os="${os%$'\n'}"
        fi
        ;;
    esac

    echo "${os}"
}

sys_arch() {
    local os
    os=$(sys_os)

    local arch

    case $os in
    freebsd)
        arch=$(uname -p)
        ;;
    fedora|debian|ubuntu)
        arch=$(uname -m)
        ;;
    esac

    case "$arch" in
        aarch64)
        arch="arm64"
        ;;
        x86_64)
        arch="amd64"
        ;;
        i686)
        arch="i386"
        ;;
    esac

    echo "$arch"
}

# Add repository for a newer version of podman
podman_add_repo() {
    info "$(printf "podman: Upgrading from repo for Ubuntu %s\n" "${ubuntu_version}")"

    sudo sh -c "echo \"deb $podman_repo_url/ /\" | tee /etc/apt/sources.list.d/devel:kubic:libcontainers:unstable.list"
    sudo sh -c "curl -fsSL $podman_repo_key_url | gpg --dearmor | tee /etc/apt/trusted.gpg.d/devel_kubic_libcontainers_unstable.gpg > /dev/null"
    sudo apt update
}

# Install podman
podman_install() {
    local os
    local cmd

    os=$(sys_os)

    case "$os" in
    debian|ubuntu)
        sudo apt update -y
        # Prepare for cross-builds with --platform if we are on amd64
        if [ "amd64" = "$(sys_arch)" ]; then
            sudo apt install -y podman qemu-user-static binfmt-support
            sudo docker run --rm --privileged multiarch/qemu-user-static --reset -p yes
        fi
        ;;
    fedora)
        sudo dnf update -y
        # Prepare for cross-builds with --platform if we are on amd64
        if [ "amd64" = "$(sys_arch)" ]; then
            sudo dnf install -y podman qemu-user-static
            sudo systemctl restart systemd-binfmt
        fi
        ;;
    esac
}

container_platform() {
    local target_arch
    target_arch="$1"

    if [ "x86_64" = "${target_arch}" ]; then
        echo "linux/amd64"
    elif [ "amd64" = "${target_arch}" ]; then
        echo "linux/amd64"
    elif [ "arm64" = "${target_arch}" ]; then
        echo "linux/arm64"
    else
        echo ""
    fi
}

# arm64 kernels are "Image", not "bzImage" - that's x86-only naming
kernel_file_for_arch() {
    local target_arch
    target_arch="${1}"

    if [ "arm64" = "${target_arch}" ]; then
        echo "Image-arm64-vm"
    else
        echo "bzImage-virt-amd64"
    fi
}

# FreeBSD's TARGET/TARGET_ARCH pair doesn't match arm64/aarch64
# 1:1: TARGET is the machine family (arm64), TARGET_ARCH is the
# specific machine arch (aarch64). For amd64 both are the same.
freebsd_target() {
    local target_arch
    target_arch="${1}"

    if [ "arm64" = "${target_arch}" ]; then
        echo "arm64"
    else
        echo "amd64"
    fi
}

freebsd_target_arch() {
    local target_arch
    target_arch="${1}"

    if [ "arm64" = "${target_arch}" ]; then
        echo "aarch64"
    else
        echo "amd64"
    fi
}

# Recursively walk gpart's MBR -> BSD label layout (used by both
# nanobsd and mini-memstick images) to find the freebsd-ufs partition,
# without hardcoding slice/partition numbers
find_ufs_partition() {
    local geom
    geom="${1}"

    local part
    part="$(gpart show -p "${geom}" 2>/dev/null | awk '$4 == "freebsd-ufs" {print $3; exit}')"
    if [ -n "${part}" ]; then
        echo "${part}"
        return 0
    fi

    local slice
    slice="$(gpart show -p "${geom}" 2>/dev/null | awk '$4 == "freebsd" {print $3; exit}')"
    if [ -n "${slice}" ]; then
        find_ufs_partition "${slice}"
        return $?
    fi

    return 1
}

# Set a known root password and enable the serial console on a built
# disk image, so CI can boot-test it headless under qemu (-nographic
# -serial pipe:...). Images built here have no NANO_CUSTOMIZE/release.sh
# hook late enough to do this pre-image, so it's done post-build by
# mounting the image directly
freebsd_customize_image() {
    local image
    image="${1}"
    local password
    password="${2}"

    local md
    md="$(mdconfig -a -t vnode -f "${image}")"

    local part
    part="$(find_ufs_partition "${md}")"
    if [ -z "${part}" ]; then
        mdconfig -d -u "${md}"
        error "$(printf "freebsd_customize_image: could not find a freebsd-ufs partition in %s\n" "${image}")"
        return 1
    fi

    local mnt
    mnt="$(mktemp -d)"
    mount "/dev/${part}" "${mnt}"

    echo "${password}" | pw -R "${mnt}" usermod root -h 0
    sed -i "" -e '/^tty[du]0/s/off/onifconsole/' "${mnt}/etc/ttys"
    echo 'console="comconsole"' >> "${mnt}/boot/loader.conf"
    # mini-memstick images unconditionally auto-launch bsdinstall via
    # /etc/rc.local; drop it so the image boots to a plain login
    # prompt instead, since here we're smoke-testing the built
    # kernel/world, not the installer
    rm -f "${mnt}/etc/rc.local"

    umount "${mnt}"
    rmdir "${mnt}"
    mdconfig -d -u "${md}"
}

freebsd_install_build_dependencies() {
    # Install build dependencies
    pkg install -y curl python

    # If the freebsd-src checkout's owner uid doesn't match the uid
    # running this script, git's dubious-ownership check would abort
    # build steps (e.g. nanobsd.sh) that shell out to git. This can
    # happen e.g. when running in a GitHub Action (or any VM with
    # sshfs), where the source is synced in and built as a different
    # user, like the action does
    git config --global --add safe.directory '*'
}

# src.conf / make.conf / release.conf
freebsd_fetch_build_config() {
    local target_arch
    target_arch="${1}"

    git clone --depth 1 "${freebsd_config_url}"
    sudo cp freebsd-config/src.conf /etc/
    # MODULES_OVERRIDE lists arch-specific kernel modules (e.g. aesni
    # is amd64/i386-only), so make.conf is split per arch
    sudo cp "freebsd-config/make.conf.${target_arch}" /etc/make.conf
}

freebsd_fetch_src() {
    local freebsd_source_url
    freebsd_source_url="${1}"
    local branch
    branch="${2}"

    if [ -n "${branch}" ]; then
        git clone --depth 1 -b "${branch}" "${freebsd_source_url}"
    else
        git clone --depth 1 "${freebsd_source_url}"
    fi
}

build_freebsd_kernel() {
    local target_arch
    target_arch="${1}"
    local arch_flags
    arch_flags="TARGET=$(freebsd_target "${target_arch}") TARGET_ARCH=$(freebsd_target_arch "${target_arch}")"

    cd freebsd-src
    local version
    version="$(freebsd-version)"

    info "$(printf "Building version: %s\n" "${version}")"
    sh -c "make ${arch_flags} buildkernel"

    mkdir -p /tmp/build
    sh -c "DESTDIR=/tmp/build make ${arch_flags} installkernel"
}

build_freebsd_world() {
    local target_arch
    target_arch="${1}"
    local arch_flags
    arch_flags="TARGET=$(freebsd_target "${target_arch}") TARGET_ARCH=$(freebsd_target_arch "${target_arch}")"

    local version
    version="$(freebsd-version)"

    mkdir -p /usr/obj
    mount -t tmpfs tmpfs /usr/obj

    sh -c "make ${arch_flags} -j4 buildworld"
    mkdir -p /tmp/build
    sh -c "DESTDIR=/tmp/build make ${arch_flags} installworld"
}

build_freebsd_release() {
    local target_arch
    target_arch="${1}"
    local version
    version="$(freebsd-version)"
    local src_path
    src_path="freebsd-src"
    # target_path is the CHROOTDIR
    # the release script builds in
    local target_path
    target_path="/release"
    local release_archive
    release_archive="freebsd-${version}-${target_arch}.tar.xz"

    info "$(printf "Building release for version %s (%s)\n" "${version}" "${target_arch}")"
    mkdir -p "$target_path/etc"
    cp freebsd-config/release.conf "$target_path/etc"

    # release.conf ships amd64 defaults; override for the requested arch
    cat >> "$target_path/etc/release.conf" <<EOF
TARGET="$(freebsd_target "${target_arch}")"
TARGET_ARCH="$(freebsd_target_arch "${target_arch}")"
EOF

    cd "${src_path}"
    local release_log
    release_log="$(mktemp)"
    sh -c "release/release.sh -c $target_path/etc/release.conf mini-memstick" 2>&1 | tee "${release_log}"

    if grep -q "SYSTEM_COMPILER: .* will be built" "${release_log}"; then
        error "clang/lld bootstrap was triggered"
    else
        info "No clang/lld bootstrap triggered"
    fi
    rm -f "${release_log}"

    local memstick_image
    memstick_image="$(find "$target_path/R" -maxdepth 1 -name '*mini-memstick.img' | head -1)"
    if [ -n "${memstick_image}" ]; then
        freebsd_customize_image "${memstick_image}" "${freebsd_ci_root_password}"
        cp "${memstick_image}" "mini-memstick-${target_arch}.img"
    else
        error "$(printf "build_freebsd_release: no mini-memstick.img found under %s/R\n" "${target_path}")"
    fi

    info "$(printf "Creating compressed archive: %s\n" "${release_archive}")"
    tar cJf "${release_archive}" "${target_path}"
}

build_nanobsd_world() {
    local target_arch
    target_arch="${1}"
    local version
    version="$(freebsd-version)"

    # nanobsd.sh hardcodes NANO_SRC=/usr/src in defaults.sh and only
    # a -c config file sourced during arg parsing can override it, so
    # point it at our actual checkout instead of the /usr/src default.
    # NANO_ARCH feeds TARGET_ARCH via nano_global_make_env, but nanobsd
    # has no equivalent for TARGET, so extend CONF_WORLD (shared by
    # both the build and install make.conf) to carry it too
    local nano_conf
    nano_conf="$(mktemp)"
    cat > "${nano_conf}" <<EOF
NANO_SRC=$(pwd)
NANO_ARCH=$(freebsd_target_arch "${target_arch}")
CONF_WORLD="\${CONF_WORLD}
TARGET=$(freebsd_target "${target_arch}")
"
EOF

    # nanobsd.sh redirects buildworld/buildkernel output into log
    # files under NANO_OBJ instead of stdout, and aborts silently on
    # failure (set -e, no error message), so surface the tail of
    # those logs here since NANO_OBJ lives outside the synced
    # workspace and would otherwise be lost with the VM
    if ! sh tools/tools/nanobsd/nanobsd.sh -c "${nano_conf}"; then
        error "nanobsd build failed, dumping build logs:"
        local log
        for log in /usr/obj/nanobsd.*/_.bw /usr/obj/nanobsd.*/_.bk; do
            if [ -f "${log}" ]; then
                error "=== tail -n 200 ${log} ==="
                tail -n 200 "${log}" >&2
            fi
        done
        exit 1
    fi

    freebsd_customize_image "/usr/obj/nanobsd.full/_.disk.full" "${freebsd_ci_root_password}"
}

