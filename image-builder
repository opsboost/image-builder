gentoo_fetch_stage3() {
    local target_arch
    target_arch="${1}"

    local gentoo_stage3_repo_url
    gentoo_stage3_repo_url="https://bouncer.gentoo.org/fetch/root/all/releases/${target_arch}/autobuilds/current-stage3-${target_arch}-systemd/"
