# Register and clone one or more Portage overlays given as a
# space-separated list of git URLs (e.g. GENTOO_OVERLAYS=
# "https://github.com/bbusse/bbusse-overlay"). The repo name used for
# both the repos.conf section and /var/db/repos path is the URL's
# basename with a trailing .git stripped.
gentoo_add_overlays() {
    local mnt_path
    mnt_path="${1}"
    local overlays
    overlays="${2}"

    mkdir -p "${mnt_path}/etc/portage/repos.conf"

    local url name
    # shellcheck disable=SC2086 # $overlays is an intentional word-split URL list
    for url in ${overlays}; do
        name="$(basename "${url%.git}")"
        info "$(printf "Gentoo: Adding overlay %s (%s)\n" "${name}" "${url}")"

        cat <<EOF > "${mnt_path}/etc/portage/repos.conf/${name}.conf"
[${name}]
location = /var/db/repos/${name}
sync-type = git
sync-uri = ${url}
auto-sync = yes
EOF
        git clone --depth 1 "${url}" "${mnt_path}/var/db/repos/${name}"
    done
}

# Merge the stage4 binpkgs onto the stage3 rootfs install_rootfs just
# extracted. The "stage4" artifact from gentoo-build is just a
# /var/cache/binpkgs cache (see its Containerfile), not a mergeable
# filesystem snapshot, so a plain tar overlay would leave the binary
# packages sitting unmerged - chroot in and emerge --usepkg them,
# same as emerge.sh did to build them in the first place
gentoo_install_stage4_binpkgs() {
    local target_flavour
    target_flavour="${1}"
    local target_arch
    target_arch="${2}"
    local rootfs_dev
    rootfs_dev="${3}"
    local mnt_path
    mnt_path="${4}"

    local stage4_file
    stage4_file="gentoo-stage4-${target_flavour}-${target_arch}.tar.xz"

    mount -t xfs "${rootfs_dev}" "${mnt_path}"

    info "$(printf "Gentoo: Extracting stage4 binpkgs\n")"
    tar xpf "${stage4_file}" --xattrs-include='*.*' --numeric-owner --directory "${mnt_path}"
    verify_stage_fs "${rootfs_dev}" "${mnt_path}" "stage4: tar extract"

    info "$(printf "Gentoo: Installing Portage config\n")"
    git clone --depth 1 "${gentoo_config_url}"
    mkdir -p "${mnt_path}/etc/portage/package.use" "${mnt_path}/etc/portage/package.unmask"
    cp gentoo-config/make.conf "${mnt_path}/etc/portage/"
    cp gentoo-config/package.use "${mnt_path}/etc/portage/package.use/"
    cp gentoo-config/package.unmask/* "${mnt_path}/etc/portage/package.unmask/"
    cp gentoo-config/package.accept_keywords "${mnt_path}/etc/portage/package.accept_keywords/"
    cp -r gentoo-config/sets "${mnt_path}/etc/portage/sets"

    if [ -n "${GENTOO_OVERLAYS}" ]; then
        gentoo_add_overlays "${mnt_path}" "${GENTOO_OVERLAYS}"
        verify_stage_fs "${rootfs_dev}" "${mnt_path}" "stage4: overlays"
    fi

    # DNS resolution inside the chroot (emerge-webrsync needs network)
    cp /etc/resolv.conf "${mnt_path}/etc/resolv.conf"
    verify_stage_fs "${rootfs_dev}" "${mnt_path}" "stage4: portage config"

    chroot_mounts "${mnt_path}"

    info "$(printf "Gentoo: Syncing Portage tree\n")"
    chroot "${mnt_path}" emerge-webrsync
    verify_stage_fs "${rootfs_dev}" "${mnt_path}" "stage4: emerge-webrsync" 1

    # Mirror gentoo-build/emerge.sh's set list per flavour - keep in
    # sync with that script if the sets it installs ever change
    local sets
    case "${target_flavour}" in
    containeros)
        sets="@container-podman @essentials @net"
        ;;
    sway)
        sets="@dev @dev-lang @sway @essentials @virt @net"
        ;;
    k3s)
        sets="@k8s @essentials @net"
        ;;
    esac

    info "$(printf "Gentoo: Merging stage4 binpkgs (%s)\n" "${target_flavour}")"
    # --usepkgonly would refuse to resolve virtual/* (deliberately left
    # out of the binpkgs by emerge.sh's --buildpkg-exclude) at all; use
    # --usepkg instead so those few packages can still build from
    # source, while --newuse --update reconciles USE-flag differences
    # against what stage3 already has installed (e.g. iptables)
    # instead of erroring out on the resulting slot conflict
    # shellcheck disable=SC2086 # $sets is an intentional word-split set list
    chroot "${mnt_path}" emerge --usepkg --newuse --update --getbinpkg=n ${sets}

    # Diagnostic: confirm the merge actually landed on this mount before
    # unmounting, so a future "file missing after boot" report can be
    # traced to either the merge itself or something later in the
    # pipeline (e.g. provision's own re-mount)
    info "$(printf "Gentoo: Post-merge check\n")"
    ls -la "${mnt_path}/usr/bin/podman" || true
    sync

    unmount_recursive "${mnt_path}"
}

