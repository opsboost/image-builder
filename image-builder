# Create a temporary playbook to
# provision host with given roles
ansible_write_playbook() {
    local roles_str
    roles_str="${1}"
    local file
    file="$(mktemp)"

cat <<EOF > "${file}"
---
- hosts: all
  vars:
    ansible_host_key_checking: false

  roles:
EOF

    while IFS=',' read -ra roles; do
      for i in "${roles[@]}"; do
        printf "    - %s\n" "${i}" >> "${file}"
      done
    done <<< "$roles_str"

    echo "${file}"
}

