# Populate rootfs
unmount_recursive() {
    local mnt_path
    mnt_path="${1}"

    if ! command -v findmnt >/dev/null 2>&1; then
        error "$(printf "unmount_recursive: findmnt is required but not installed\n")"
        exit 1
    fi

    if ! findmnt -rno TARGET "${mnt_path}" >/dev/null 2>&1; then
        info "$(printf "unmount_recursive: nothing mounted at %s\n" "${mnt_path}")"
        return 0
    fi

    info "$(printf "unmount_recursive: unmounting %s\n" "${mnt_path}")"
    findmnt -R "${mnt_path}" || true

    sync

    if ! umount -R "${mnt_path}"; then
        error "$(printf "unmount_recursive: Failed to unmount %s\n" "${mnt_path}")"
        findmnt -R "${mnt_path}" || true
        fuser -vm "${mnt_path}" 2>&1 || true
        exit 1
    fi

    if findmnt -rno TARGET "${mnt_path}" >/dev/null 2>&1; then
        error "$(printf "unmount_recursive: %s still mounted after umount\n" "${mnt_path}")"
        findmnt -R "${mnt_path}" || true
        exit 1
    fi

    sync
}

chroot_mounts() {
    local mnt_path
    mnt_path="${1}"

    # Detach the mount point from the propagation tree before rbinding
    # anything into it. Without this the rootfs mount propagates into every
    # peer mount namespace - on a systemd host that is most system services -
    # and umount_recursive only removes our own copy. The others keep the
    # filesystem mounted and the loop device busy, invisible to findmnt, so
    # xfs_repair then reads a live filesystem and reports a dirty log with
    # thousands of phantom inconsistencies
    mount --make-rprivate "${mnt_path}"
    mount --types proc /proc "${mnt_path}/proc"
    mount --rbind /sys "${mnt_path}/sys"
    mount --make-rslave "${mnt_path}/sys"
    mount --rbind /dev "${mnt_path}/dev"
    mount --make-rslave "${mnt_path}/dev"
}

verify_stage_fs() {
    local rootfs_dev
    rootfs_dev="${1}"
    local mnt_path
    mnt_path="${2}"
    local context
    context="${3}"
    local remount_chroot
    remount_chroot="${4:-0}"

    if [ "1" != "${VERIFY_FS_STAGES:-0}" ]; then
        return 0
    fi

    unmount_recursive "${mnt_path}"
    verify_filesystem "${rootfs_dev}" "${context}"

    if ! mount -t xfs "${rootfs_dev}" "${mnt_path}"; then
        error "$(printf "verify_stage_fs: Failed to remount %s at %s\n" "${rootfs_dev}" "${mnt_path}")"
        exit 1
    fi

    if [ "1" == "${remount_chroot}" ]; then
        chroot_mounts "${mnt_path}"
    fi
}

replay_log_xfs() {
    local dev
    dev="${1}"

    local replay_dir
    replay_dir="$(mktemp -d)"

    info "$(printf "replay_log_xfs: mounting %s at %s to replay log\n" "${dev}" "${replay_dir}")"

    if mount -t xfs "${dev}" "${replay_dir}"; then
        findmnt -R "${replay_dir}" || true
        if ! umount "${replay_dir}"; then
            error "$(printf "replay_log_xfs: Failed to unmount %s after log replay\n" "${dev}")"
            rmdir "${replay_dir}" 2>/dev/null || true
            exit 1
        fi
    else
        error "$(printf "replay_log_xfs: Failed to mount %s to replay its log\n" "${dev}")"
        rmdir "${replay_dir}" 2>/dev/null || true
        exit 1
    fi

    sync
    blockdev --flushbufs "${dev}" 2>/dev/null || true
    rmdir "${replay_dir}" 2>/dev/null || true
    info "$(printf "replay_log_xfs: log replayed on %s\n" "${dev}")"
}

# Resolved argv of the last fs_check_cmd call
fs_check_argv=()

# Resolve the read only check command for a filesystem type into
# fs_check_argv. Most types need no entry here: util-linux installs an
# fsck.TYPE helper and the generic branch uses it. Entries exist only
# where that helper is not a real checker - fsck.xfs and fsck.btrfs are
# deliberate no-op stubs - where a check has to be forced, or where the
# tool goes by another name
fs_check_cmd() {
    local fs_type
    fs_type="${1}"
    local dev
    dev="${2}"

    fs_check_argv=()

    case "${fs_type}" in
    "")
        return 1
        ;;
    xfs)
        fs_check_argv=(xfs_repair -n "${dev}")
        ;;
    btrfs)
        fs_check_argv=(btrfs check --readonly "${dev}")
        ;;
    ext2|ext3|ext4)
        # -f checks even a filesystem already marked clean
        fs_check_argv=(e2fsck -f -n "${dev}")
        ;;
    ufs|ufs2)
        # The BSDs call it fsck_ffs and util-linux ships no fsck.ufs
        fs_check_argv=(fsck_ffs -n "${dev}")
        ;;
    *)
        fs_check_argv=("fsck.${fs_type}" -n "${dev}")
        ;;
    esac
}

# Work a filesystem needs before a read only check will succeed
fs_prepare() {
    local fs_type
    fs_type="${1}"
    local dev
    dev="${2}"

    case "${fs_type}" in
    xfs)
        # xfs_repair refuses a dirty log, so mount once to replay it
        replay_log_xfs "${dev}"
        ;;
    esac
}

verify_filesystem() {
    local dev
    dev="${1}"
    local context
    context="${2}"

    local verify
    verify=1
    if [ "0" == "${VERIFY_FS:-1}" ]; then
        verify=0
    fi

    if [ ! -b "${dev}" ] && [ ! -c "${dev}" ]; then
        if [ "0" == "${verify}" ]; then
            return 0
        fi
        error "$(printf "verify_filesystem: Device does not exist: %s\n" "${dev}")"
        exit 1
    fi

    if ! command -v findmnt >/dev/null 2>&1; then
        if [ "0" == "${verify}" ]; then
            return 0
        fi
        error "$(printf "verify_filesystem: findmnt is required but not installed\n")"
        exit 1
    fi

    if findmnt -rno SOURCE "${dev}" >/dev/null 2>&1 || grep -q "^${dev} " /proc/mounts 2>/dev/null; then
        if [ "0" == "${verify}" ]; then
            return 0
        fi
        error "$(printf "verify_filesystem: %s is mounted, cannot check it\n" "${dev}")"
        findmnt -R "${dev}" || true
        grep "^${dev} " /proc/mounts || true
        exit 1
    fi

    local fs_type
    fs_type="$(blkid -o value -s TYPE "${dev}" 2>/dev/null)"

    fs_prepare "${fs_type}" "${dev}"

    if [ "0" == "${verify}" ]; then
        return 0
    fi

    if ! fs_check_cmd "${fs_type}" "${dev}"; then
        info "$(printf "verify_filesystem: No filesystem detected on %s, skipping\n" "${dev}")"
        return 0
    fi

    if ! command -v "${fs_check_argv[0]}" >/dev/null 2>&1; then
        info "$(printf "verify_filesystem: %s not installed, skipping check of %s (%s)\n" \
                       "${fs_check_argv[0]}" "${dev}" "${fs_type}")"
        return 0
    fi

    info "$(printf "Verifying %s (%s)%s\n" "${dev}" "${fs_type}" "${context:+ after: ${context}}")"

    if ! "${fs_check_argv[@]}"; then
        error "$(printf "Filesystem check failed on %s (%s)%s\n" \
                        "${dev}" "${fs_type}" "${context:+ after: ${context}}")"
        info "$(printf "loop devices:\n")"
        losetup -l || true
        info "$(printf "kernel log (tail):\n")"
        dmesg | tail -n 80 || true
        error "$(printf "Set VERIFY_FS=0 to skip filesystem verification\n")"
        exit 1
    fi
}

install_rootfs() {
    local rootfs_dev
    rootfs_dev="${1}"
    local mnt_path
    mnt_path="${2}"
    local fs_type
    fs_type="${3}"

    info "Installing sys to root fs"
