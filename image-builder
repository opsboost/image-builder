main() {
    DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/${UID}/bus}"
    local service_user
    service_user=iss
    local mnt_path
    mnt_path="/mnt/disk-image"

    # Source vars
    if [ -f ENVIRONMENT ]; then
        source ENVIRONMENT
    fi

    if [ -z "${DEBUG+x}" ]; then
        DEBUG=0
    fi

    if [ -z "${SEND_NOTIFICATION+x}" ]; then
        SEND_NOTIFICATION=0
    fi

    local build_use_container
    build_use_container="${BUILD_USE_CONTAINER:-0}"

    local net_dev
    net_dev="${NET_DEV:-"enp0s1"}"

    local net_host_address
    net_host_address="${NET_HOST_ADDRESS:-"fd62:1d79:ef52:e133::1"}"

    local net_host_readiness_port
    net_host_readiness_port="${NET_HOST_READINESS_PORT:-1723}"

    local net_address
    net_address="${NET_ADDRESS:-"fd62:1d79:ef52:e133::ffff"}"

    local net_gateway
    net_gateway="${NET_GATEWAY:-""}"

    local net_mode
    net_mode="${NET_MODE:-"gokrazy-dhcp"}"

    local ansible_user
    local ansible_roles
    local ansible_roles_path
    ansible_user="${ANSIBLE_USER:-""}"

    if [ -n "${ANSIBLE_ROLES}" ]; then
        ansible_roles="${ANSIBLE_ROLES}"
        if [ -z "${ANSIBLE_ROLES_PATH}" ]; then
            error "Ansible: You need to specify the path to Ansible's roles"
            exit 1
        elif [ ! -d "${ANSIBLE_ROLES_PATH}" ]; then
            error "$(printf "Ansible: The supplied roles path does not exist: %s\n" \
                   "${ANSIBLE_ROLES_PATH}")"
            exit 1
        else
            ansible_roles_path="${ANSIBLE_ROLES_PATH}"
        fi
    fi

    # Show help
    if [ "help" == "${1}" ]; then
        show_usage
        exit 0
    fi

    # No arguments: show usage
    if [ $# -eq 0 ]; then
        show_usage
        exit 1
    fi

    # Build
    if [ "build" == "${1}" ]; then
        local build_target
        build_target="${2}"
        local target_arch
        target_arch="${3}"

        # Take target_arch from env if not provided
        # on command line or fall back to host arch
        # if none given
        if [ -z "$target_arch" ]; then
            local host_arch
            host_arch=$(sys_arch)
            target_arch="${TARGET_ARCH:-$host_arch}"
        fi

        case "$build_target" in
        alpine-sway|alpine-containeros)
            local target_flavour
            target_flavour=${build_target#*alpine-}

            alpine_build "$target_flavour" ""
            exit 0
            ;;
        freebsd)
            local release
            release="${4}"
            local freebsd_branch
            if [ -n "${release}" ]; then
                # Pin to the matching release branch. Without this,
                # the default branch (main/CURRENT) gets built instead,
                # which the base image's installed compiler doesn't
                # match closely enough to be trusted, forcing a full
                # clang/lld bootstrap rebuild from scratch
                freebsd_branch="releng/${release}"
            fi

            freebsd_install_build_dependencies
            freebsd_fetch_build_config "${target_arch}"
            freebsd_fetch_src "${freebsd_source_url}" "${freebsd_branch}"

            if [ "${freebsd_use_release_script}" = "true" ]; then
                build_freebsd_release "${target_arch}"
            else
                build_freebsd_kernel "${target_arch}"
                build_freebsd_world "${target_arch}"
            fi
            exit 0
            ;;
        nanobsd)
            freebsd_install_build_dependencies
            freebsd_fetch_src "${freebsd_source_url}"
            build_freebsd_kernel "${target_arch}"
            build_nanobsd_world "${target_arch}"
            exit 0
            ;;
        gentoo-containeros)
            local target_flavour
            target_flavour="containeros"

            build_gentoo_stage4 "$target_flavour" "$target_arch"
            return
            ;;
        gentoo-sway)
            local target_flavour
            target_flavour="sway"

            build_gentoo_stage4 "$target_flavour" "$target_arch"
            return
            ;;
        gentoo-sway-virt)
            local target_flavour
            target_flavour="sway-virt"

            build_gentoo_stage4 "$target_flavour" "$target_arch"
            return
            ;;
        gentoo-sway-pine64)
            local target_flavour
            target_flavour="sway"
            # pine64 is real Allwinner arm64 hardware, not a target
            # arch choice - force it regardless of what was passed
            target_arch="arm64"

            build_gentoo_stage4 "$target_flavour" "$target_arch"
            return
            ;;
        gentoo-k3s)
            local target_flavour
            target_flavour="k3s"

            build_gentoo_stage4 "$target_flavour" "$target_arch"
            return
            ;;
        gentoo-stage3)
            build_gentoo_stage3
            gentoo_fetch_stage3 "${target_arch}"
            return
            ;;
        linux-kernel)
            target_arch="${4:-$TARGET_ARCH}"

            if [ -n "${3}" ]; then
                kernel_flavour="${3}"
            elif [ -n "${KERNEL_FLAVOUR}" ]; then
                kernel_flavour="${KERNEL_FLAVOUR}"
            else
                error "Please specify a kernel flavour\nAborting.."
                exit 1
            fi

            if [ -z "${target_arch}" ]; then
                case "$kernel_flavour" in
                    pine64)
                    target_arch="arm64"
                    ;;
                    rockpro64)
                    target_arch="arm64"
                    ;;
                    arm64-vm)
                    target_arch="arm64"
                    ;;
                    x230)
                    target_arch="amd64"
                    ;;
                    virt-amd64)
                    target_arch="amd64"
                    ;;
                    *)
                    error "Please specify a target architecture\nAborting.."
                    exit 1
                esac
            fi

            linux_build_kernel "${kernel_flavour}" \
                               "${build_use_container}" \
                               "${target_arch}"
            exit 0
            ;;
        nomadbsd)
            nomadbsd_build "${target_arch}"
            exit 0
            ;;
        openwrt)

            if [ -n "${3}" ]; then
                flavour="${3}"
            else
                error "Please specify a flavour to build\nAborting.."
                exit 1
            fi

            openwrt_build "${flavour}"
            exit 0
            ;;
        u-root)
            build_u_root "$target_arch"
            exit 0
            ;;
        esac
    fi

    # Create disk image
    if [ "create" == "${1}" ]; then
        reexec_privileged "$@"

        local build_target
        build_target="${2}"
        local target_arch
        target_arch="${3}"

        if [ -z "$target_arch" ]; then
            local host_arch
            host_arch=$(sys_arch)
            target_arch="${TARGET_ARCH:-$host_arch}"
        fi

        # pine64 is real Allwinner arm64 hardware, not a target arch
        # choice - force it regardless of what was passed
        case "$build_target" in
        *-pine64) target_arch="arm64" ;;
        esac

        local img_path
        local img_file
        img_file="$build_target-$target_arch".raw

        if [ -n "${OLDPWD}" ]; then
            img_path="${OLDPWD}"
        else
            img_path="${PWD}"
        fi

        local img
        img="${img_path}/${img_file}"

        case "$build_target" in
        alma)
            reexec_privileged "$@"

            target_img_file="alma.img"
            download "${alma_csum_url}" "${img_path}"
            local csum
            local csum_file
            csum_file="${img_path}/${alma_img_file}.sha256"
            csum=$(awk "/SHA256/ && /${alma_img_file}/" "${img_path}/${alma_csum_file}")
            echo "${csum}" > "${csum_file}"

            if [ -f "${img_path}/${alma_img_file}" ]; then
                info "$(printf "Alma: Checking checksum..\n")"
                if ! sha256sum -c "${csum_file}"; then
                    download "${alma_img_url}" "${img_path}"
                fi
            else
                download "${alma_img_url}" "${img_path}"
            fi

            info "$(printf "The image was downloaded successfully\n")"

            gentoo_create_disk  "${img_path}" \
                                "${target_img_file}" \
                                "${mnt_path}"

            printf "\n"
            disk_show_storage_devices
            printf "\n"
            info "$(printf "%s\n\n" "You can continue with")"
            info "$(printf " # image-builder write %s [DEVICE]" "${build_target}")"
            exit 0
            ;;
        alpine-sway|alpine-containeros)
            # We need root privileges
            reexec_privileged "$@"

            local target_flavour
            target_flavour=${build_target#*alpine-}

            alpine_create_disk "build" \
                               "${img_path}" \
                               "${img_file}" \
                               "${alpine_img_url}" \
                               "${alpine_csum_url}" \
                               "${alpine_csum_file}" \
                               "${service_user}" \
                               "${target_flavour}"

            info "$(printf "Alpine: Provisioning image\n")"

            # We need to apply changes to both partitions: A/B
            #provision_image "${path}/${file}" \
            #                "${mnt_path}" \
            #                "${user}" \
            #                2 \
            #                "${net_dev}" \
            #                "${net_address}" \
            #                "${net_gateway}" \
            #                "${ansible_user}" \
            #                "${ansible_roles}"

            #provision_image "${path}/${file}" \
            #                "${mnt_path}" \
            #                "${user}" \
            #                3 \
            #                "${net_dev}" \
            #                "${net_address}" \
            #                "${net_gateway}" \
            #                "${ansible_user}" \
            #                "${ansible_roles}"
            exit 0
            ;;
        gentoo-containeros|gentoo-sway|gentoo-sway-virt|gentoo-sway-pine64|gentoo-k3s|containeros-virt|nomadbsd)
            # download_miss/gentoo_fetch_stage3 (called below) expect a
            # "path" in scope to fetch into
            local path
            path="${img_path}"

            # Describe the image as a set of slots, then build it slot
            # by slot: one rootfs, kernel and boot entry per system
            composition_load "${build_target}" "${target_arch}"
            composition_show

            local reduce_gpt_table
            if [ "gentoo-sway-pine64" = "${build_target}" ]; then
                reduce_gpt_table="1"
            fi

            # Fetch and stage every slot's payload before the disk is
            # touched, so a failed download leaves no half-built image
            composition_fetch "${path}" "${target_arch}"

            gentoo_create_disk  "${img_path}" \
                                "${img_file}" \
                                "${mnt_path}" \
                                "" \
                                "${reduce_gpt_table}"

            local esp_dev
            esp_dev=$(esp)

            install_bootloader_efi "${esp_dev}" "${mnt_path}"
            install_kernels "${esp_dev}" "${mnt_path}" "${path}"
            install_rootfs_slots "${mnt_path}" "${path}"
            install_boot_entries "${esp_dev}" "${mnt_path}"

            # Binpkgs and provisioning apply to the Gentoo slots only
            local i
            for i in "${!comp_name[@]}"; do
                if [ "gentoo" != "${comp_provider[$i]}" ]; then
                    continue
                fi

                local slot_dev
                slot_dev="$(part_dev "${comp_part[$i]}")"

                gentoo_install_stage4_binpkgs "${comp_provider_arg[$i]}" \
                                              "${target_arch}" \
                                              "${slot_dev}" \
                                              "${mnt_path}"
                verify_filesystem "${slot_dev}" "stage4 binpkgs"

                info "$(printf "Gentoo: Provisioning %s\n" "${comp_name[$i]}")"

                # We need to apply changes to both partitions: A/B
                # But we do not have partition B yet (not implemented for Gentoo)
                provision "${img_path}/${img_file}" \
                          "${mnt_path}" \
                          "${user}" \
                          "${comp_part[$i]}" \
                          "${net_dev}" \
                          "${net_address}" \
                          "${net_gateway}" \
                          "${ansible_user}" \
                          "${ansible_roles_path}" \
                          "${ansible_roles}" \
                          "${net_mode}"

                verify_filesystem "${slot_dev}" "provision"
            done

            verify_filesystem "${esp_dev}" "provision"

            # Tear down loop devices after installation steps
            loop_unmount ""

            printf "\n"
            info "$(printf "%s\n\n" "You can continue with")"
            info "$(printf " # image-builder write %s [DEVICE]\n" "${build_target}")"

            exit 0
            ;;
        freebsd)
            freebsd_create_disk "${img_path}"
            exit 0
            ;;
        *)
            printf "\n"
            printf "You need to specify a valid target system OS\n"
            printf "  One of: alma, alpine-containeros, alpine-sway,\n"
            printf "          containeros-virt, freebsd, gentoo-containeros,\n"
            printf "          gentoo-k3s, gentoo-sway, gentoo-sway-pine64,\n"
            printf "          gentoo-sway-virt, nomadbsd\n"
            show_usage
            exit 1
        esac
    fi

    # Install image-builder
    if [ "install" == "${1}" ]; then
        install_builder "${SCRIPT_PATH}/${SCRIPT_NAME}" \
                        "/usr/local/bin"
        exit 0
    fi

    # Mount disk image
    if [ "mount" == "${1}" ] || [ "chroot" == "${1}" ]; then
        local part_no
        part_no="${2}"

        if [ "" == "${part_no}" ]; then
            error "You need to specify the partition number to mount"
            exit 1
        fi

        # We need root privileges
        check_root_fail

        if [ ! -e "${img}" ]; then
            error "$(printf "Can not find disk image: %s" "${img}")"
            exit 1
        fi

        local fs_type
        fs_type="$(filesystem "${img}" "${part_no}")"
        fs_type="$(echo -n "$fs_type")"

        mount_disk_image_part_by_no "${img}" \
                                    "${mnt_path}" \
                                    "${part_no}" \
                                    "${fs_type}"

        if [ "chroot" == "${1}" ]; then
            chroot "${mnt_path}" "/bin/sh"
        fi

        # Show mount content
        ls "${mnt_path}"

        exit 0
    fi

    if [ "show" == "${1}" ] ; then
        local object
        object="${2}"
        if [ -z "${object}" ]; then
            error "$(printf "Missing argument\n")"
            error "$(printf "The 'show' command needs an object to show\n")"
            exit 1
        elif [ "partitions" == "${object}" ]; then
            local partitions
            partitions="$(disk_partitions "${img}")"
            info "$(printf "%s" "${partitions}")"
            exit 0
        fi
    fi

    # Unmount
    if [ "umount" == "${1}" ]; then
        unmount_recursive "${mnt_path}"
        exit 0
    fi

    # Write disk image to device
    if [ "write" == "${1}" ]; then
        # We need root privileges
        check_root_fail

        local img
        local img="${2}"
        local img_file

        case "$img" in
        alma)
            img_file="${alma_img_file}"
            ;;
        alpine)
            img_file="alpine.img"

            # alpine_build leaves the disk image xz-compressed
            # (alpine.img.xz); decompress it here so 'write' can
            # operate on the same output 'create'/'build' produced
            if ! [ -f "${img_path}/${img_file}" ] && \
               [ -f "${img_path}/${img_file}.xz" ]; then
                info "$(printf "Alpine: Decompressing %s\n" "${img_file}.xz")"
                xz -d -k "${img_path}/${img_file}.xz"
            fi
            ;;
        gentoo-sway-pine64)
            # pine64 is always arm64 - matches the naming 'create' used
            img_file="${img}-arm64.raw"
            ;;
        *)
            # Every composed target is written as "<target>-<arch>.raw",
            # the same name 'create' gave it
            local write_arch
            write_arch="${4:-${TARGET_ARCH:-$(sys_arch)}}"
            img_file="${img}-${write_arch}.raw"
            ;;
        esac

        if ! [ -f "${img_path}/${img_file}" ]; then
            error "$(printf "A local image for '%s' does not exist" "${img}")"
            info "You need to create one first"
            printf "\n"
            info " # image-builder create alma"
            exit 1
        fi

        local device
        device="${3}"
        if [ "" == "${device}" ]; then
            printf "Missing device\n"
            printf "The 'write' command needs a device to write to\n"
            exit 1
        fi

        # test -c is needed for usb mass storage device on FreeBSD
        # -b works on Linux
        if ! [ -b "${device}" ] && ! [ -c "${device}" ]; then
            printf "Unsupported device: %s\n" "${device}"
            printf "Is a card or device inserted?\n"
            printf "Not writing image\n"
            exit 1
        fi

        local r
        r=$(write_image_to_disk "${img_path}/${img_file}" "${device}")

        if [ 0 != "$r" ]; then
            error "Failed to write image"
        fi

        if [ "gentoo-sway-pine64" = "${img}" ]; then
            # FreeBSD Ports contains builds for Pine64/RockPro64
            local img_bootloader
            img_bootloader="/usr/local/share/u-boot/u-boot-pine64/u-boot-sunxi-with-spl.bin"
            info "Writing u-boot bootloader"
            install_bootloader_u_boot "${img_bootloader}" "${device}"
        fi

        if $SEND_NOTIFICATION; then
            if ! notify-send "image-builder: Done writing image"; then
                error "$(printf "Failed to send notification\n")"
            fi
        fi

        info "$(printf "image-builder: Done writing image\n")"

        exit 0
    fi

    # Provision disk image
    if [ "provision" == "${1}" ]; then
        # We need root privileges
        check_root_fail

        info "$(printf "Gentoo: Provisioning image\n")"

        provision "${img_path}/${img_file}" \
                  "${mnt_path}" \
                  "${user}" \
                  3 \
                  "${net_dev}" \
                  "${net_address}" \
                  "${net_gateway}" \
                  "${ansible_user}" \
                  "${ansible_roles_path}" \
                  "${ansible_roles}" \
                  "${net_mode}"

        exit 0
    fi

    # Run disk image
    if [ "run" == "${1}" ]; then
        if [ -e "${img}" ]; then
            local os
            os=$(sys_os)

            case "$os" in
            gentoo-containeros|fedora)
                run_virt_linux "${img}"
                 exit 0
                 ;;
            freebsd)
                run_virt_freebsd "${img}"
                 exit 0
                 ;;
            esac
        else
            error "$(printf "Can not find disk image: %s" "${img}")"
            exit 1
        fi
    fi

    if [ -z "${1}" ]; then
        error "$(printf "Please provide a valid verb\n")"
        show_usage
        exit 1
    fi

    error "$(printf "%s is not a valid verb\n" "${1}")"
    show_usage
    exit 1
}

args=("$@")
main "$@"
