alpine_fetch_image() {
    cd "${path}" || exit 1
    info "Alpine: Fetching pre-built image"
    download_miss "${path}" \
                  "${img_url}" \
                  "${csum_url}" \
                  "${csum_file}"

    if [ -f "${file}" ]; then
        info "Uncompressed disk image exists: Not overwriting existing one"
    else
        if [ ! -e "${compressed_file}" ];  then
            error "$(printf "Failed to decompress: File does not exist. Aborting..\n")"
            exit 1
        else
            if ! xz -d -k -f "${compressed_file}"; then
                error "$("Failed to decompress file. Aborting..\n")"
                exit 1
            fi
        fi
    fi
}

gentoo_create_disk() {
    local path
    path="${1}"
    local disk_file
    disk_file="${path}/${2}"
    local mnt_path
    mnt_path="${3}"
    local reduce_gpt_table
    reduce_gpt_table="${5}"
    local rootfs_dev
    rootfs_dev=$(rootfs)
    local esp_dev
    esp_dev=$(esp)

    local os
    os="$(sys_os)"

    if [ -z "$disk_file" ]; then
        error "$(printf "Missing disk file.\n Please provide a disk file to use.\nAborting..")"
    fi

    # Reached by targets that partition a disk without describing a
    # composition; give them the single-rootfs layout they had before
    if [ 0 = "$(comp_count)" ]; then
        composition_load "default" "${target_arch}"
    fi

    create_disk "${disk_file}" "${reduce_gpt_table}"

    case "$os" in
    ubuntu|fedora)
        loop_mount_linux "${disk_file}"
        ;;
    freebsd)
        loop_mount_freebsd "${disk_file}"
        ;;
    esac

    # Create filesystems: the ESP, then one per slot
    case "$os" in
    ubuntu|fedora)
        info "Creating file systems"
        if ! mkfs.vfat "${esp_dev}"; then
            error "$(printf "Error: Failed to create filesystem on %s\n" "${esp_dev}")"
            exit 1
        fi
        composition_mkfs
        ;;
    freebsd)
        esp_dev="/dev/md99p1"
        rootfs_dev="/dev/md99p2"
        if ! newfs_msdos -F32 -c 1 "${esp_dev}"; then
            error "$(printf "Error: Failed to create filesystem\n")"
            loop_unmount_freebsd 99
            exit 1
        fi
        if ! mkfs.xfs -s size=4096 "${rootfs_dev}"; then
            error "$(printf "Error: Failed to create filesystem\n")"
            exit 1
        fi
        ;;
    esac

    # Keep loop device mounted for subsequent install steps
    # Caller is responsible for loop teardown after installs
}

