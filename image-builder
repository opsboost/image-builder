# We also use this in a github-action
linux_build_kernel() {
    local kernel_flavour
    kernel_flavour="${1}"
    local build_use_container
    build_use_container="${2}"
    local target_arch
    target_arch="${3}"
    local kernel_version
    kernel_version="${4}"

    kernel_config_url="${kernel_config_url}/kernel-config-${kernel_flavour}"
    download "${kernel_config_url}"

    # Set to 'latest' for now, if not given
    # We'll determine the exact version later
    if [ -z "${kernel_version}" ]; then
        kernel_version="latest"
    fi

    info "$(printf "Building kernel version %s for %s with arch %s\n" "${kernel_version}" "${kernel_flavour}" "${target_arch}")"

    if [ 1 = "${build_use_container}" ]; then
        local platform
        platform=$(container_platform "$target_arch")

        if [ -z "$platform" ]; then
            error "$(printf "kernel-build: Unsupported target arch: %s\n" "${target_arch}")"
            error "kernel-build: target_arch must be amd64 or arm64\n"
        fi

        if [ "1" = "${PODMAN_USE_EXTERNAL_REPO:-1}" ]; then
            #podman_add_repo
            printf "Skipping repo installation\n"
        fi

        podman_install

        mkdir -p "${PWD}/output"
        git clone --depth 1 "${kernel_src_url}" output/linux

        cd output/linux

        if [ -z "${kernel_version}" ]; then
            kernel_version="$(make kernelversion)"
        fi

        cd ../../

        mv "kernel-config-${kernel_flavour}" output/linux/.config
        podman buildx build --cap-add=SYS_PTRACE \
                            --platform="${platform}" \
                            --build-arg KERNEL_VERSION="${kernel_version}" \
                            --build-arg KERNEL_CONFIG="kernel-config-${kernel_flavour}" \
                            -v "${PWD}"/output:/output \
                            -t "ghcr.io/bbusse/linux-kernel-${kernel_flavour}:latest" \
                            -f Containerfile .
    else
        linux_install_kernel_build_dependencies "${target_arch}"

        local kernel_arch_dir
        local kernel_image_name
        if [ "arm64" = "${target_arch}" ]; then
            kernel_arch_dir="arm64"
            kernel_image_name="Image"
        else
            kernel_arch_dir="x86_64"
            kernel_image_name="bzImage"
        fi

        mv "kernel-config-${kernel_flavour}" .config

        if [ "arm64" = "${target_arch}" ]; then
            ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu- make -j3
        else
            make -j3
        fi

        mv "arch/${kernel_arch_dir}/boot/${kernel_image_name}" \
           "arch/${kernel_arch_dir}/boot/${kernel_image_name}-${kernel_version}"
        sha384sum "arch/${kernel_arch_dir}/boot/${kernel_image_name}-${kernel_version}" \
            > "arch/${kernel_arch_dir}/boot/${kernel_image_name}-${kernel_version}.sha384"
    fi
}

alpine_build() {
