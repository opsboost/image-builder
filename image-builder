create_disk() {
    local file_disk
    file_disk="${1}"
    local reduce_gpt_table
    reduce_gpt_table="${2}"

    info "$(printf "Creating disk file %s..\n" "${file_disk}")"
    # 16GB: shared by gentoo_create_disk's callers (Gentoo, Alma), but
    # this size only matters for Gentoo - its xfs partition now also
    # holds a synced Portage tree (~1GB) plus stage4 binpkgs on top of
    # stage3, which no longer fit in the previous 8GB total. Alma just
    # inherits the larger disk incidentally
    dd if=/dev/zero of="${file_disk}" bs=1M count=16384 status=progress


    case "$os" in
    ubuntu|fedora)
        # Create partition layout
        parted "${file_disk}" mklabel gpt
        parted "${file_disk}" mkpart fat32 1 2
        parted "${file_disk}" mkpart fat32 3 259
        parted "${file_disk}" mkpart xfs 260 16GB
        parted "${file_disk}" set 2 boot on
        parted "${file_disk}" print

        if [ -n "${reduce_gpt_table}" ]; then
            # A default GPT reserves 128 entries (16KiB, up to byte
            # 17408) for the partition array, which overlaps the byte
            # 8192 offset a pine64 U-Boot SPL gets dd'd into. Only 3
            # partitions are ever used here, so 8 entries (1KiB) is
            # plenty and clears that offset with room to spare
            info "Shrinking GPT partition entry table to clear the pine64 U-Boot SPL offset"
            sgdisk --resize-table=8 "${file_disk}"
        fi
        ;;
    freebsd|macos)
        loop_mount_freebsd "${file_disk}"
        gpart create -s gpt /dev/md99
        gpart add -t efi -s 512m -l efi0 /dev/md99
        gpart add -t linux-data -l rootfs0 /dev/md99
        loop_unmount_freebsd 99
        ;;
    *)
        error "$(printf "Unsupported OS for create_disk: %s\n" "${os}")"
        error "Aborting.."
        exit 1
        ;;
    esac
}

loop_exists() {
    [ "/dev/loop0" != "$(losetup -f)" ]
}

# Returns the last created loop device
# or 1 if none exists
loop_device() {
    local loop_dev
    loop_dev="$(losetup -f)"

    if [ "/dev/loop0" == "${loop_dev}" ]; then
        echo 1
    else
        read -r nloop_dev <<<"${loop_dev//[^0-9]/ }"
        local n
        n=$((nloop_dev-1))
        echo "/dev/loop${n}"
    fi
}

esp() {
    echo "/dev/loop0p2"
}

rootfs() {
    echo "/dev/loop0p3"
}

# Set up loop mount
loop_mount() {
    local disk_file
    disk_file="${1}"
    local os
    os=$(sys_os)

    case "$os" in
    fedora|ubuntu)
        loop_mount_linux "${disk_file}"
        ;;
    macos)
        loop_mount_macos "${disk_file}"
        ;;
    freebsd)
        loop_mount_freebsd "${disk_file}"
        ;;
    esac
}

loop_mount_macos() {
    local loop_device
    loop_device="${1}"

    printf "Loop mounting: %s\n" "${loop_device}"
}

loop_mount_freebsd() {
    local disk_file
    disk_file="${1}"

    r="$(mdconfig -l)"

    if ! [ "$r" == "" ]; then
        error "A loop mount exists"
        exit 1
    fi

    info "$(printf "Mounting %s" "${disk_file}")"
    mdconfig -a -t vnode -f "${disk_file}" -u 99
}

# Set up loop mount
loop_mount_linux() {
    local disk_file
    disk_file="${1}"

    printf "Loop mounting %s\n" "${disk_file}"

    local existing
    existing="$(losetup -j "${disk_file}" -O NAME --noheadings 2>/dev/null | head -1)"
    existing="$(trim "${existing}")"

    if [ -n "${existing}" ]; then
        if [ "/dev/loop0" != "${existing}" ]; then
            error "$(printf "loop_mount: %s is attached to %s, but this tool assumes /dev/loop0\n" \
                            "${disk_file}" "${existing}")"
            losetup -l
            exit 1
        fi
        printf "Reusing loop device %s for %s\n" "${existing}" "${disk_file}"
        return 0
    fi

    if loop_exists; then
        local loop_dev
        loop_dev="$(loop_device)"
        local mounts
        mounts="$(loop_mounts)"

        printf "\n"
        printf "Warning: A loop device already exists!\n\n"

        if [ "" != "${mounts}" ]; then
            printf "Remove loop mounts to proceed:\n"
            printf "%s\n\n" "${mounts}"
        fi

        printf "Remove existing loop devices to poceed:\n"
        printf "%s\n\n" "${loop_dev}"
        printf " # losetup -D\n\n"
        losetup -l
        printf "\nAborting..\n"
        exit 1
    fi

    modprobe loop

    if ! sudo losetup -P -f "${disk_file}"; then
        error "$(printf "Failed to loop mount %s\n" "${disk_file}")"
        dmesg
        exit 1
    fi
}

loop_unmount() {
    local disk_file
    disk_file="$1"

    os="$(sys_os)"

    case "$os" in
    debian|ubuntu|fedora)
        loop_unmount_linux
        ;;
    freebsd)
        loop_unmount_freebsd "${disk_file}"
        ;;
    esac
}

# FreeBSD: Tear down loop mount
loop_unmount_freebsd() {
    mdconfig -d -u "${1}"
}

# Linux: Tear down loop mount
loop_unmount_linux() {
    sync
    losetup -D
}

# Returns active loop mounts
loop_mounts() {
    local mounts
    mounts="$(mount | grep loop | awk '{print $1}')"
    echo "${mounts}"
}


